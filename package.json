  "devDependencies": {
    "@dotenvx/dotenvx": "^1.59.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.12.0",
      "form-data": ">=4.0.6",
      "devalue": ">=5.9.2",
      "seroval": ">=1.5.4",
      "hono": ">=4.12.7",
      "dompurify": ">=3.4.13",
      "lodash-es": ">=4.18.0",
      "tar": ">=7.5.21",
      "brace-expansion@1": ">=1.1.18",
      "brace-expansion@2": ">=2.1.4",
      "js-yaml": ">=4.3.2",
      "browserslist": ">=4.28.7",
      "mermaid": ">=11.16.1",
      "fast-uri": ">=3.1.6",
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.1",
