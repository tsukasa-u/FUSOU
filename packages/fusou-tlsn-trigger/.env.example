# Copy this file to .env and encrypt it with packages/.env.keys.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TLSN_TRIGGER_DEPLOYMENT_ROLE=production

# Canary only: set the role to "canary" and provide all three fixed-target values.
# TLSN_TRIGGER_SERVER_IDENTITY=
# TLSN_TRIGGER_PROFILE_SHA256=
# TLSN_TRIGGER_SPARSE_PROFILE_SHA256=

# Internal TLSN Worker callback boundary.
TLSN_WORKER_INTERNAL_URL=https://your-tlsn-worker.example
TLSN_TRIGGER_CALLBACK_SECRET=

# Pinned TLSN verification configuration.
TLSN_TRIGGER_VERIFIER_KEY_ID=
TLSN_TRIGGER_NOTARY_KEY_ID=
TLSN_TRIGGER_NOTARY_REGISTRY=
