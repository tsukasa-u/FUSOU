# Copy this file to .env and encrypt it with packages/.env.keys.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Internal TLSN Worker callback boundary.
TLSN_WORKER_INTERNAL_URL=https://your-tlsn-worker.example
