---
interface Props {
  container?: "compact" | "narrow" | "default" | "wide";
  paddingY?: "0" | "6" | "8" | "12";
  class?: string;
}

const { container = "default", paddingY = "8", class: className } = Astro.props as Props;

const containerClass =
  container === "compact"
    ? "max-w-lg"
    : container === "narrow"
      ? "max-w-2xl"
      : container === "wide"
        ? "max-w-[1500px]"
        : "max-w-[1440px]";

const paddingClass =
  paddingY === "0"
    ? "py-0"
    : paddingY === "6"
      ? "py-6"
      : paddingY === "12"
        ? "py-12"
        : "py-8";
---

<main class="fusou-page">
  <div class:list={["fusou-page-container", containerClass, paddingClass, className]}>
    <slot />
  </div>
</main>