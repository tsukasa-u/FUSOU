---
interface Props {
  title: string;
  subtitle?: string;
  compact?: boolean;
  align?: "left" | "center";
}

const { title, subtitle = "", compact = false, align = "left" } = Astro.props as Props;
const isCenter = align === "center";
---

<div class:list={["fusou-page-header", isCenter && "text-center items-center justify-center"]}>
  <div class:list={[isCenter && "max-w-2xl mx-auto"]}>
    <h1
      class:list={[compact ? "fusou-page-title-compact" : "fusou-page-title"]}
    >
      {title}
    </h1>
    {
      subtitle && (
        <p
          class:list={[
            compact ? "fusou-page-subtitle-compact" : "fusou-page-subtitle",
          ]}
        >
          {subtitle}
        </p>
      )
    }
  </div>
  <div class="fusou-page-actions">
    <slot name="actions" />
  </div>
</div>
