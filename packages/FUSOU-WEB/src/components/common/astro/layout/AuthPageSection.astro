---
interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className } = Astro.props as Props;
---

<section class:list={["w-full", className]}>
  <div class="mb-4">
    <h2 class="text-sm font-semibold">{title}</h2>
    <p class="mt-1 text-xs text-base-content/60">{description}</p>
  </div>
  <slot />
</section>
