---
import Navigation from "@/components/common/astro/layout/Navigation.astro";
import PageShell from "@/components/common/astro/ui/PageShell.astro";

interface Props {
  width?: "compact" | "wide";
  navigation?: boolean;
}

const { width = "wide", navigation = true } = Astro.props as Props;
const container = width === "compact" ? "compact" : "narrow";
---

{navigation && <Navigation filled={true} />}
<PageShell container={container} paddingY="8">
  <div class="flex w-full flex-col gap-6">
    <slot />
  </div>
</PageShell>