---
import PageHeader from "@/components/common/astro/ui/PageHeader.astro";
import PageShell from "@/components/common/astro/ui/PageShell.astro";

const year = new Date().getFullYear();
---

<PageShell container="medium" paddingY="8">
  <!-- Page Header: 左揃えでタイトルと説明を他ページと統一 -->
  <PageHeader subtitle="艦これ 戦闘ログ収集・可視化 & 編成シミュレータ">
    <div slot="title" class="flex items-center gap-3">
      <img src="/favicon.svg" alt="FUSOU" class="w-8 h-8 rounded shrink-0" />
      <h1 class="fusou-page-title leading-none">FUSOU</h1>
      <span
        class="badge badge-sm badge-outline text-base-content/60 font-mono translate-y-[2px]"
        >v0.5.0</span
      >
    </div>
  </PageHeader>

  <div class="space-y-8 mt-6">
    <!-- Main Feature Cards Grid: タイトルの左端とコンテンツ端を揃える -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 w-full text-left">
      <!-- Simulator Card -->
      <div
        class="fusou-card border-t-4 border-t-secondary shadow-sm flex flex-col justify-between"
      >
        <div class="fusou-card-body gap-4 flex-1 flex flex-col">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-secondary/10 text-secondary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  d="M2 4.75A1.75 1.75 0 013.75 3h12.5A1.75 1.75 0 0118 4.75v7.5A1.75 1.75 0 0116.25 14H3.75A1.75 1.75 0 012 12.25v-7.5z"
                ></path>
                <path
                  d="M6 16.5a.75.75 0 01.75-.75h6.5a.75.75 0 010 1.5h-6.5A.75.75 0 016 16.5z"
                ></path>
              </svg>
            </div>
            <div>
              <h2 class="card-title text-lg font-bold">編成シミュレータ</h2>
              <p class="text-xs text-base-content/60">艦隊編成・制空計算</p>
            </div>
          </div>

          <p class="text-sm text-base-content/75 leading-relaxed">
            艦隊・装備・基地航空隊を自由に編集。制空値・触接率計算や共有URL発行に対応。
          </p>

          <div class="flex flex-col gap-2 mt-auto">
            <a
              href="/simulator"
              class="fusou-btn-primary justify-between py-2 text-xs font-semibold"
            >
              <div class="flex items-center gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>シミュレータを開く</span>
              </div>
              <span class="text-xs font-normal opacity-85">新規編成作成 →</span>
            </a>
            <a
              href="/simulator/details"
              class="fusou-btn-ghost justify-between border-transparent hover:border-base-300 py-2"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm">艦/装備カタログ</span>
                <span class="text-xs text-base-content/60">マスターデータ・詳細性能</span>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 opacity-50"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            </div>
        </div>
      </div>

      <!-- Data Display & Analytics Card -->
      <div
        class="fusou-card border-t-4 border-t-primary shadow-sm flex flex-col justify-between"
      >
        <div class="fusou-card-body gap-4 flex-1 flex flex-col">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-primary/10 text-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"
                ></path>
              </svg>
            </div>
            <div>
              <h2 class="card-title text-lg font-bold">データ表示・分析</h2>
              <p class="text-xs text-base-content/60">収集データ可視化</p>
            </div>
          </div>

          <p class="text-sm text-base-content/75 leading-relaxed">
            戦闘記録・パラメータ推移・クエストツリーなど、収集したデータを可視化・分析。
          </p>

          <div class="flex flex-col gap-2 mt-auto">
            <a
              href="/battles"
              class="fusou-btn-ghost justify-between border-transparent hover:border-base-300 py-2"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm">戦闘一覧 (Battles)</span>
                <span class="text-xs text-base-content/60"
                  >戦闘記録の閲覧・検証</span
                >
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 opacity-50"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <a
              href="/ship-growth"
              class="fusou-btn-ghost justify-between border-transparent hover:border-base-300 py-2"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm">パラメータ推移</span>
                <span class="text-xs text-base-content/60"
                  >艦レベル・パラメータ成長</span
                >
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 opacity-50"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <a
              href="/quests"
              class="fusou-btn-ghost justify-between border-transparent hover:border-base-300 py-2"
            >
              <div class="flex items-center gap-2">
                <span class="font-medium text-sm">クエストツリー</span>
                <span class="text-xs text-base-content/60"
                  >推定クエストツリー閲覧</span
                >
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 opacity-50"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- FUSOU-APP Integration Card -->
    <div class="fusou-card border-base-300 shadow-sm p-6 text-left">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="badge badge-sm badge-primary font-mono">FUSOU-APP</span>
            <h3 class="font-bold text-base text-base-content">
              デスクトップ連携アプリ
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">
            ゲーム通信から戦闘記録や所持データを自動取得するローカルプロキシ兼専用ブラウザです。
          </p>
        </div>
        <a
          href="/download"
          class="fusou-btn-primary shrink-0 gap-1.5 text-xs font-semibold py-2 px-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          アプリをダウンロード
        </a>
      </div>
    </div>

    <!-- Structured Documentation & Policy Links -->
    <section>
      <h3 class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-3">
        ドキュメント・方針・コミュニティ
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-left">
        <!-- Overview & About -->
        <div class="fusou-card p-4 space-y-3">
          <h4
            class="font-semibold text-sm flex items-center gap-2 text-base-content border-b border-base-300 pb-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-primary"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z"
                clip-rule="evenodd"></path>
            </svg>
            プロジェクトについて
          </h4>
          <ul class="space-y-2 text-xs text-base-content/80">
            <li>
              <a
                href="/docs/start/what_is_fusou"
                class="link link-hover hover:text-primary">FUSOU とは</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/architecture"
                class="link link-hover hover:text-primary">アーキテクチャ概要</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/api_overview"
                class="link link-hover hover:text-primary">API概要 & 仕様</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/fusou_datasets/getting_started"
                class="link link-hover hover:text-primary"
                >データセットガイド (SDK)</a
              >
            </li>
          </ul>
        </div>

        <!-- Guides -->
        <div class="fusou-card p-4 space-y-3">
          <h4
            class="font-semibold text-sm flex items-center gap-2 text-base-content border-b border-base-300 pb-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-info"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"
              ></path>
            </svg>
            機能ガイド
          </h4>
          <ul class="space-y-2 text-xs text-base-content/80">
            <li>
              <a
                href="/docs/guide/battles_view"
                class="link link-hover hover:text-info">戦闘一覧の使い方</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/ship_growth_view"
                class="link link-hover hover:text-info">パラメータ推移ガイド</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/quest_tree_view"
                class="link link-hover hover:text-info">クエストツリーの見方</a
              >
            </li>
            <li>
              <a
                href="/docs/guide/simulator"
                class="link link-hover hover:text-info">シミュレータ操作方法</a
              >
            </li>
          </ul>
        </div>

        <!-- Policies -->
        <div class="fusou-card p-4 space-y-3">
          <h4
            class="font-semibold text-sm flex items-center gap-2 text-base-content border-b border-base-300 pb-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-secondary"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            運用方針と規約
          </h4>
          <ul class="space-y-2 text-xs text-base-content/80">
            <li>
              <a
                href="/docs/policy/communication_integrity_policy"
                class="link link-hover hover:text-secondary">通信安全基準</a
              >
            </li>
            <li>
              <a
                href="/docs/policy/fusou_dataset_license_policy"
                class="link link-hover hover:text-secondary">データ利用方針</a
              >
            </li>
            <li>
              <a
                href="/docs/policy/copyright_quotation_policy"
                class="link link-hover hover:text-secondary">著作権・引用方針</a
              >
            </li>
            <li>
              <a
                href="/docs/policy/privacy"
                class="link link-hover hover:text-secondary">プライバシー方針</a
              >
            </li>
          </ul>
        </div>

        <!-- Community -->
        <div class="fusou-card p-4 space-y-3">
          <h4
            class="font-semibold text-sm flex items-center gap-2 text-base-content border-b border-base-300 pb-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-accent"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z"
                clip-rule="evenodd"></path>
            </svg>
            連絡先 & コミュニティ
          </h4>
          <ul class="space-y-2 text-xs text-base-content/80">
            <li>
              <a href="/contact" class="link link-hover hover:text-accent"
                >お問い合わせ・削除申請</a
              >
            </li>
            <li>
              <a
                href="https://github.com/tsukasa-u/FUSOU"
                target="_blank"
                rel="noreferrer"
                class="link link-hover hover:text-accent">GitHub リポジトリ</a
              >
            </li>
            <li>
              <a
                href="https://github.com/tsukasa-u/FUSOU/discussions"
                target="_blank"
                rel="noreferrer"
                class="link link-hover hover:text-accent">GitHub Discussions</a
              >
            </li>
            <li>
              <a
                href="https://github.com/tsukasa-u/FUSOU/issues"
                target="_blank"
                rel="noreferrer"
                class="link link-hover hover:text-accent">Issue / バグ報告</a
              >
            </li>
            <li>
              <a
                href="https://wavebox.me/wave/byvjx7nrs7350t54/"
                target="_blank"
                rel="noreferrer"
                class="link link-hover hover:text-accent">Wavebox でメッセージ</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Footer Note -->
    <footer
      class="fusou-footer-note pt-4 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-base-content/60"
    >
      <div>&copy; {year} FUSOU Project.</div>
      <div class="flex gap-4">
        <a
          href="/docs/policy/terms"
          class="hover:text-base-content transition-colors">利用規約</a
        >
        <a
          href="/docs/policy/privacy"
          class="hover:text-base-content transition-colors">プライバシー</a
        >
        <a
          href="/docs/policy/copyright_quotation_policy"
          class="hover:text-base-content transition-colors">著作権</a
        >
        <a
          href="https://github.com/tsukasa-u/FUSOU/blob/main/LICENSE"
          target="_blank"
          rel="noreferrer"
          class="hover:text-base-content transition-colors">ライセンス</a
        >
      </div>
    </footer>
  </div>
</PageShell>
