---
export interface Props {
  headings: {
    slug: string;
    text: string;
    depth: number;
  }[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 2);
---

<div class="sticky top-20">
  <div class="max-h-[calc(100vh-6rem)] overflow-y-auto overflow-x-hidden pr-2 scrollbar-thin">
    <div class="flex items-center justify-between mb-3 pb-1 border-b border-base-300/40">
      <span class="text-[11px] font-bold uppercase tracking-wider text-base-content/50">
        On this page
      </span>
      <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-base-200 text-base-content/60">
        {tocHeadings.length}
      </span>
    </div>

    {
      tocHeadings.length > 0 ? (
        <nav aria-label="On this page navigation">
          <ul class="border-l border-base-300/60 space-y-1 text-xs text-base-content/70">
            {
              tocHeadings.map((heading) => (
                <li class={`heading-level-${heading.depth}`}>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link block py-1 px-2.5 transition-colors text-base-content/70 hover:text-base-content hover:bg-base-content/8 rounded"
                    data-toc-link={heading.slug}
                  >
                    {heading.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      ) : (
        <p class="text-xs text-base-content/50">No section headings</p>
      )
    }

    <div class="mt-4 pt-3 border-t border-base-300/40 flex items-center justify-between text-xs text-base-content/60">
      <a href="#" class="inline-flex items-center gap-1 hover-text-brand transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
        <span>Back to top</span>
      </a>
      <a href="/docs" class="hover-text-brand transition-colors">
        Docs Index
      </a>
    </div>
  </div>
</div>

<style>
  .heading-level-2 {
    padding-left: 0;
  }
  .heading-level-3 {
    padding-left: 0.75rem;
  }
  .heading-level-4,
  .heading-level-5,
  .heading-level-6 {
    padding-left: 1.25rem;
  }

  :global(.toc-link.is-active) {
    color: var(--color-brand-text) !important;
    font-weight: 600;
    background: color-mix(in oklch, var(--color-primary) 12%, transparent);
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--color-base-content) 15%, transparent);
    border-radius: 9999px;
  }
</style>

<script is:inline>
  const links = Array.from(document.querySelectorAll("[data-toc-link]"));
  if (links.length > 0) {
    const bySlug = new Map();
    links.forEach((link) => {
      const slug = link.getAttribute("data-toc-link");
      if (slug) bySlug.set(slug, link);
    });

    const setActive = (slug) => {
      links.forEach((link) => link.classList.remove("is-active"));
      const active = slug ? bySlug.get(slug) : null;
      if (active) active.classList.add("is-active");
    };

    const sections = Array.from(bySlug.keys())
      .map((slug) => document.getElementById(slug))
      .filter(Boolean);

    if (sections.length > 0 && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: "-96px 0px -68% 0px", threshold: [0, 1] },
      );
      sections.forEach((el) => observer.observe(el));
    }

    const hash = window.location.hash.replace(/^#/, "");
    if (hash) setActive(hash);
  }
</script>
