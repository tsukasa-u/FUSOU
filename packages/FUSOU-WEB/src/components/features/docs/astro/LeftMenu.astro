---
import type { MarkdownInstance } from "astro";
import { compareSegments } from "@/utils/page_sorter";

const rawPostsGlobResult = import.meta.glob("@docs/**/*.md", {
  eager: true,
});
const rawPosts = Object.values(
  rawPostsGlobResult
).reverse() as MarkdownInstance<Record<string, unknown>>[];

const normalizeSlug = (value: unknown) =>
  (typeof value === "string" ? value : "")
    .replace(/^\/+|\/+$/g, "")
    .replace(/^docs\//, "");

const formatSegment = (segment: string) =>
  segment
    .split(/[-_]/g)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");

const SECTION_CONFIG: Record<string, { label: string; order: number }> = {
  start: { label: "GETTING STARTED", order: 1 },
  guide: { label: "GUIDES", order: 2 },
  formulas: { label: "FORMULAS & VERIFICATION", order: 3 },
  schema: { label: "API REFERENCE", order: 4 },
  "design-system": { label: "DESIGN SYSTEM", order: 5 },
  policy: { label: "POLICIES", order: 6 },
};

type PostEntry = {
  slug: string;
  segments: string[];
  title: string;
  url: string;
  isExternal?: boolean;
};

const posts = rawPosts
  .map((post) => {
    const slug = normalizeSlug(post.frontmatter?.["slug"]);
    const segments = slug.split("/").filter(Boolean);
    if (segments.length === 0) return null;

    return {
      slug,
      segments,
      title: post.frontmatter?.["title"] ?? formatSegment(segments.at(-1)!),
      url: `/docs/${slug}`,
    };
  })
  .filter(Boolean) as PostEntry[];

const postsWithSchema: PostEntry[] = [
  {
    slug: "schema/api-schema-explorer",
    segments: ["schema", "api-schema-explorer"],
    title: "API Schema Explorer",
    url: "/docs/api-schema",
    isExternal: true,
  },
  ...posts,
  {
    slug: "design-system/catalog",
    segments: ["design-system", "catalog"],
    title: "Component Catalog",
    url: "/design-system",
    isExternal: true,
  },
];

type MenuNode = {
  segment: string;
  title: string;
  url?: string;
  isExternal?: boolean;
  children: Map<string, MenuNode>;
};

type MenuEntry = {
  segment: string;
  title: string;
  url?: string;
  isExternal?: boolean;
  children: MenuEntry[];
};

const root = new Map<string, MenuNode>();

for (const entry of postsWithSchema) {
  let current = root;
  entry.segments.forEach((segment, index) => {
    const isLeaf = index === entry.segments.length - 1;
    if (!current.has(segment)) {
      current.set(segment, {
        segment,
        title: isLeaf ? entry.title : formatSegment(segment),
        children: new Map(),
        ...(isLeaf ? { url: entry.url, isExternal: entry.isExternal } : {}),
      });
    } else if (isLeaf) {
      const node = current.get(segment)!;
      node.title = entry.title;
      node.url = entry.url;
      if (entry.isExternal !== undefined) node.isExternal = entry.isExternal;
    }
    current = current.get(segment)!.children;
  });
}

const compareDocsSegments = (a: { segment?: string | null }, b: { segment?: string | null }) => {
  const aSeg = a.segment ?? "";
  const bSeg = b.segment ?? "";
  const aOrder = SECTION_CONFIG[aSeg]?.order ?? 99;
  const bOrder = SECTION_CONFIG[bSeg]?.order ?? 99;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return compareSegments(a, b);
};

const mapToArray = (nodeMap: Map<string, MenuNode>): MenuEntry[] =>
  Array.from(nodeMap.values())
    .sort(compareDocsSegments)
    .map((node: MenuNode): MenuEntry => ({
      segment: node.segment,
      title: node.title,
      ...(node.url === undefined ? {} : { url: node.url }),
      ...(node.isExternal ? { isExternal: true } : {}),
      children: mapToArray(node.children),
    }));

const menuTree = mapToArray(root);
const currentPath = Astro.url.pathname;

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const sanitizeDocsUrl = (value: string | undefined): string | null => {
  if (!value) return null;
  if (value === "/design-system") return "/design-system";
  if (!value.startsWith("/docs/")) return null;
  const slug = value.slice("/docs/".length);
  const safeSlug = slug
    .split("/")
    .filter(Boolean)
    .map((segment) => encodeURIComponent(segment))
    .join("/");
  return safeSlug ? `/docs/${safeSlug}` : "/docs";
};

const externalIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-3.5 h-3.5 ml-1 shrink-0 opacity-60 -translate-y-px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>`;

const chevronSvg = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0 transition-transform group-open:rotate-90 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>`;

const renderMenuHtml = (nodes: MenuEntry[], isRoot = false): string =>
  nodes
    .map((node: MenuEntry) => {
      const safeUrl = sanitizeDocsUrl(node.url);
      const isActive = safeUrl === currentPath;
      const icon = node.isExternal ? externalIconSvg : "";

      if (isRoot) {
        const sectionTitle = SECTION_CONFIG[node.segment]?.label ?? node.title.toUpperCase();
        const children = node.children.length
          ? `<ul class="mt-1 space-y-0.5 border-l border-base-300/60 ml-2 pl-2">${renderMenuHtml(node.children, false)}</ul>`
          : "";

        return `
          <li class="pt-3 first:pt-0">
            <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-base-content/50 select-none">
              ${escapeHtml(sectionTitle)}
            </div>
            ${children}
          </li>
        `;
      }

      const children = node.children.length
        ? `<ul class="mt-1 space-y-0.5 border-l border-base-300/60 ml-2 pl-2">${renderMenuHtml(node.children, false)}</ul>`
        : "";

      if (safeUrl) {
        return `
          <li>
            <a
              href="${escapeHtml(safeUrl)}"
              class="docs-nav-link group relative flex items-center justify-between rounded-md px-2.5 py-1.5 text-xs font-medium transition-all ${
                isActive
                  ? "bg-brand-soft text-brand font-semibold"
                  : "text-base-content/75 hover:bg-base-content/8 hover:text-base-content"
              }"
            >
              <span class="truncate">${escapeHtml(node.title)}</span>
              ${icon}
            </a>
          </li>
        `;
      }

      return `
        <li class="my-0.5">
          <details open class="group">
            <summary class="flex items-center justify-between rounded-md px-2.5 py-1 text-xs font-semibold text-base-content/85 hover:bg-base-content/8 cursor-pointer select-none transition-colors">
              <span class="truncate">${escapeHtml(node.title)}</span>
              ${chevronSvg}
            </summary>
            ${children}
          </details>
        </li>
      `;
    })
    .join("");

const menuHtml = renderMenuHtml(menuTree, true);
---

<div class="sticky top-20">
  <div class="max-h-[calc(100vh-6rem)] overflow-y-auto overflow-x-hidden pr-2 scrollbar-thin">
    <div class="px-2 pb-2 mb-2 border-b border-base-300/50">
      <a
        href="/docs"
        class="flex items-center gap-2 text-xs font-bold text-base-content/80 hover-text-brand transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>FUSOU Documentation</span>
      </a>
    </div>
    <nav aria-label="Documentation navigation" class="docs-sidebar-nav">
      <ul class="space-y-1 text-xs" set:html={menuHtml} />
    </nav>
  </div>
</div>

<style>
  .scrollbar-thin::-webkit-scrollbar {
    width: 4px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--color-base-content) 15%, transparent);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklch, var(--color-base-content) 30%, transparent);
  }
</style>
