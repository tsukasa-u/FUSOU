---
import ErrorView from "@/components/common/astro/ui/ErrorView.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const detailMessage = error instanceof Error ? error.message : typeof error === "string" ? error : undefined;
---

<ErrorView
  code="500"
  title="Internal Server Error"
  message="By the way, how to get here? This page is not linked from anywhere. If you found a broken link, please report it to the administrator."
  detail={detailMessage}
/>
