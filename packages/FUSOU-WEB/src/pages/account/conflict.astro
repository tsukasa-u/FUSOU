---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";
import AlertBox from "@/components/common/astro/ui/AlertBox.astro";
import { createSupabaseServerClient } from "@/lib/supabaseServer";
import { env as cfEnv } from "cloudflare:workers";

const cookies = Astro.cookies;
const runtimeEnv = cfEnv as unknown as Record<string, unknown>;
const supabase = createSupabaseServerClient(cookies, runtimeEnv);

// Read member_id_hash from a short-lived cookie set by local callback.
const memberIdHashFromCookie = cookies.get("mih-conflict-hash")?.value ?? null;
if (memberIdHashFromCookie) {
  cookies.delete("mih-conflict-hash", { path: "/account/conflict" });
}

// DEV-only fallback for manual testing with legacy URL format.
const memberIdHashFromQuery = import.meta.env.DEV
  ? Astro.url.searchParams.get("hash")
  : null;
const memberIdHash = memberIdHashFromCookie ?? memberIdHashFromQuery;

type ConflictHints = {
  masked_email?: string | null;
  last_sign_in_date?: string | null;
  account_created_date?: string | null;
};

let hints: ConflictHints | null = null;
let error: string | null = null;

if (!memberIdHash) {
  error = "Missing member_id_hash parameter";
} else {
  // Fetch safe account hints
  const { data, error: rpcError } = await supabase.rpc(
    "rpc_get_member_conflict_hints",
    {
      member_id_hash: memberIdHash,
    },
  );

  if (rpcError) {
    console.error("Failed to fetch conflict hints:", rpcError);
    error = "Failed to load account information";
  } else if (data?.success) {
    hints = data.hints;
  } else {
    error = data?.error || "Account not found";
  }
}
---

<Layout title="Account Conflict - FUSOU">
  <AuthPageShell>
    <AuthPageHeader
      title="Account Conflict"
      description="連携済みアカウントを確認し、続ける方法を選択してください。"
    />
    <div class="rounded-lg border border-base-300 bg-base-100 p-6">

        {
          error ? (
            <div class="mt-6">
              <AlertBox type="error" title="Error">
                <p>{error}</p>
              </AlertBox>
            </div>
          ) : (
            hints && (
              <>
                <div class="mt-6 space-y-4">
                  <AlertBox type="warning" title="Account Conflict">
                    <p>
                      This game account is already linked to another FUSOU
                      account.
                    </p>
                  </AlertBox>

                  <div class="bg-base-200 rounded-lg p-4">
                    <h3 class="font-semibold mb-3 text-sm">Existing Account</h3>
                    <p class="mb-3 text-xs text-base-content/60">
                      Review the masked account details before choosing a resolution.
                    </p>
                    <div class="space-y-2 text-sm">
                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 text-primary"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          />
                        </svg>
                        <span class="opacity-70">Email:</span>
                        <span class="font-mono text-xs">
                          {hints.masked_email}
                        </span>
                      </div>
                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 text-primary"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span class="opacity-70">Last Sign In:</span>
                        <span>{hints.last_sign_in_date || "Unknown"}</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 text-primary"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                        <span class="opacity-70">Account Created:</span>
                        <span>{hints.account_created_date || "Unknown"}</span>
                      </div>
                    </div>
                    <div class="mt-3 text-xs opacity-60 italic">
                      This information is provided to help you identify your
                      account. For security reasons, full details are not
                      displayed.
                    </div>
                  </div>

                  <AuthPageSection
                    title="Resolution Options"
                    description="元のアカウントへ切り替えるか、データ移行について確認します。"
                  >
                    <div class="space-y-4">
                    <div class="card bg-base-200 border-2 border-primary">
                      <div class="card-body p-4">
                        <h3 class="card-title text-sm">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 text-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                            />
                          </svg>
                          Switch to Original Account
                        </h3>
                        <p class="text-xs opacity-80">
                          Sign out from the current account and sign in with the
                          account shown above.
                        </p>
                        <div class="card-actions justify-end mt-3">
                          <a
                            id="switch-account-btn"
                            href="/auth/local/signin?return_to=%2Faccount%2Fconflict"
                            class="btn btn-primary btn-wide btn-sm"
                          >
                            Switch Account
                          </a>
                        </div>
                      </div>
                    </div>

                    <div class="card bg-base-200 border-2 border-dotted border-base-300">
                      <div class="card-body p-4">
                        <h3 class="card-title text-sm">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                            />
                          </svg>
                          Transfer Ownership
                        </h3>
                        <p class="text-xs opacity-80">
                          Move your game data from the old account to your
                          current account using a transfer code.
                        </p>
                        <div class="mt-4 mb-4">
                          <ol class="list-decimal pl-5 space-y-2 text-sm font-mono">
                            <li>Sign in with the OLD account</li>
                            <li>Generate a transfer code</li>
                            <li>Return here and enter the code</li>
                            <li>Complete the transfer</li>
                          </ol>
                        </div>
                        <div class="card-actions justify-end">
                          <button
                            id="learn-transfer-btn"
                            class="btn btn-outline btn-wide btn-sm"
                            onclick="alert('Transfer feature coming soon. Please contact support for assistance.')"
                          >
                            Learn More About Transfer
                          </button>
                        </div>
                      </div>
                    </div>

                    <AlertBox type="info" title="Need Help?">
                      <p>
                        If you cannot access the old account or need additional
                        assistance, please contact our support team.
                      </p>
                      <div class="card-actions justify-end mt-3">
                        <a
                          id="contact-support-link"
                          href="https://github.com/tsukasa-u/FUSOU/issues"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="fusou-btn-primary btn-wide"
                        >
                          Contact Support
                        </a>
                      </div>
                    </AlertBox>
                    </div>
                  </AuthPageSection>
                </div>
              </>
            )
          )
        }
    </div>

    <div class="my-6 text-center text-sm text-base-content/70">
        Your game account can only be linked to one FUSOU account. Switch to the
        correct account or transfer ownership.
    </div>
  </AuthPageShell>
</Layout>
