---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";
import { createSupabaseServerClient } from "@/lib/supabaseServer";
import type { AuthResponse } from "@supabase/supabase-js";
import { env as cfEnv } from "cloudflare:workers";

const cookies = Astro.cookies;
const runtimeEnv = cfEnv as unknown as Record<string, unknown>;
const supabase = createSupabaseServerClient(cookies, runtimeEnv);

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

function providerInitial(provider?: string): string {
  return (provider?.trim()?.charAt(0) || "?").toUpperCase();
}

let currentSession: AuthResponse | null = null;
if (!refreshToken || !accessToken) {
  return Astro.redirect("/auth/signin");
}

try {
  const session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    cookies.delete("sb-access-token", { path: "/" });
    cookies.delete("sb-refresh-token", { path: "/" });
    cookies.delete("sb-provider-token", { path: "/" });
    cookies.delete("sb-provider-refresh-token", { path: "/" });
    return Astro.redirect("/auth/signin");
  }
  currentSession = session;
} catch (_error) {
  cookies.delete("sb-access-token", { path: "/" });
  cookies.delete("sb-refresh-token", { path: "/" });
  cookies.delete("sb-provider-token", { path: "/" });
  cookies.delete("sb-provider-refresh-token", { path: "/" });
  return Astro.redirect("/auth/signin");
}

const accountUser = currentSession.data.user;
if (!accountUser) {
  return Astro.redirect("/auth/signin");
}

---

<Layout title="dashboard">
  <AuthPageShell>
    <AuthPageHeader
      title="Account is authorized"
      description="認証済みアカウントの情報を確認します。"
    />

    <div class="rounded-lg border border-base-300 bg-base-100 p-6">
      <AuthPageSection
        title="アカウント情報"
        description="現在サインインしているアカウントを確認できます。"
      >
        <div class="rounded-lg bg-base-200/50 p-4">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <span
                class="grid size-10 place-items-center rounded-full bg-base-300 text-sm font-bold text-base-content"
                title={accountUser.app_metadata.provider || "provider"}
              >
                {providerInitial(accountUser.app_metadata.provider)}
              </span>
              <div>
                <div>{accountUser.user_metadata?.["name"] || "User"}</div>
                <div class="text-xs font-semibold opacity-60">
                  {accountUser.email}
                </div>
              </div>
            </div>
          </div>

          <div class="mt-5">
            <form action="/api/auth/signout" method="post">
              <button
                id="dashboard-signout-btn"
                class="btn btn-ghost h-12 min-h-12 w-full"
                type="submit"
              >
                サインアウト
              </button>
            </form>
          </div>
        </div>
      </AuthPageSection>
    </div>

    <div class="rounded-lg border border-base-300 bg-base-100 p-6">
      <AuthPageSection
        title="管理"
        description="連携端末の確認・失効や、APIキーの管理を行います。"
      >
          <div class="space-y-3">
            <div class="grid gap-3">
              <a
                href="/dashboard/devices"
                class="group block rounded-lg bg-base-100 p-4 transition-colors hover:bg-base-200/70"
              >
                <div class="font-semibold text-link underline underline-offset-2 group-hover:text-link-hover">
                  端末管理
                </div>
                <div class="text-sm text-base-content/60 mt-1">
                  連携済み端末の確認と失効
                </div>
              </a>
              <a
                href="/dashboard/api-keys"
                class="group block rounded-lg bg-base-100 p-4 transition-colors hover:bg-base-200/70"
              >
                <div class="font-semibold text-link underline underline-offset-2 group-hover:text-link-hover">
                  APIキー管理
                </div>
                <div class="text-sm text-base-content/60 mt-1">
                  fusou-datasets の APIキーを管理します
                </div>
              </a>
            </div>
          </div>
          </AuthPageSection>
    </div>
  </AuthPageShell>
</Layout>
