  <script is:inline>
    (() => {
      const wrap = document.getElementById("mock-vol-wrap");
      const btn = document.getElementById("mock-vol-btn");
      const pop = document.getElementById("mock-vol-pop");
      const range = document.getElementById("mock-vol-range");
      const muteBtn = document.getElementById("mock-mute-btn");
      const volLabel = document.getElementById("mock-vol-label");
      const volText = document.getElementById("vol-val-text");
      const iconOn = document.getElementById("mock-vol-icon-on");
      const iconMuted = document.getElementById("mock-vol-icon-muted");

      if (!wrap || !btn || !pop || !range || !muteBtn || !volLabel || !volText || !iconOn || !iconMuted) {
        return;
      }

      let volume = Number(range.value) || 80;
      let isMuted = false;

      const setOpen = (open) => {
        pop.classList.toggle("hidden", !open);
        pop.classList.toggle("flex", open);
        btn.classList.toggle("fusou-active", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      };

      const renderVolume = () => {
        const effectiveMuted = isMuted || volume === 0;
        volLabel.textContent = effectiveMuted ? "0%" : `${volume}%`;
        volText.textContent = effectiveMuted ? "Muted" : `${volume}%`;
        muteBtn.classList.toggle("is-muted", effectiveMuted);
        muteBtn.textContent = effectiveMuted ? "Unmute" : "Mute Audio";
        iconOn.classList.toggle("hidden", effectiveMuted);
        iconMuted.classList.toggle("hidden", !effectiveMuted);
      };

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(pop.classList.contains("hidden"));
      });

      document.addEventListener("click", (e) => {
        if (!pop.classList.contains("hidden") && !wrap.contains(e.target)) {
          setOpen(false);
        }
      });

      range.addEventListener("input", () => {
        volume = Number(range.value);
        isMuted = volume === 0;
        renderVolume();
      });

      muteBtn.addEventListener("click", () => {
        isMuted = !isMuted;
        if (!isMuted && volume === 0) {
          volume = 50;
          range.value = "50";
        }
        renderVolume();
      });

      renderVolume();
    })();
  </script>
