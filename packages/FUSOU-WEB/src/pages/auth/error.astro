---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";

const reason = Astro.url.searchParams.get("reason") ?? "unknown";

const messageMap: Record<string, string> = {
  no_code:
    "認証コードが見つかりませんでした。もう一度サインインを試みてください。",
  exchange_failed:
    "認証コードの検証に失敗しました。時間をおいて再度お試しください。",
  server_misconfiguration:
    "サーバーの設定に問題が発生しました。管理者にお問い合わせください。",
  unknown:
    "認証中に予期しないエラーが発生しました。もう一度サインインを試みてください。",
};

const message = messageMap[reason] ?? messageMap["unknown"];
---

<Layout title="認証エラー - FUSOU">
  <AuthPageShell width="compact">
    <AuthPageHeader
      title="認証に失敗しました"
      description="サインインを完了できませんでした。"
    />
    <div class="rounded-lg border border-base-300 bg-base-100 p-6">
      <AuthPageSection
        title="認証結果"
        description="表示された内容を確認して、もう一度お試しください。"
      >
        <p class="text-sm text-base-content/70 text-center leading-relaxed">
          {message}
        </p>
      </AuthPageSection>

      <AuthPageSection
        title="次の操作"
        description="サインインをやり直すか、トップページへ戻ります。"
        class="mt-6"
      >
        <div class="flex flex-col gap-3 w-full">
          <a href="/auth/signin" class="btn btn-primary w-full">
            サインインページへ戻る
          </a>
          <a href="/" class="btn btn-ghost w-full"> トップページへ </a>
        </div>
      </AuthPageSection>

      <AuthPageSection
        title="サポート"
        description="問題が続く場合はお問い合わせください。"
        class="mt-6"
      >
        <p class="mt-6 text-xs text-base-content/50 text-center">
          問題が続く場合は
          <a href="/contact" class="underline hover:no-underline"
            >お問い合わせページ</a
          >
          からご連絡ください。
        </p>
      </AuthPageSection>
    </div>
  </AuthPageShell>
</Layout>
