---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";
import AuthLinkSteps from "@/components/common/astro/layout/AuthLinkSteps.astro";
import AlertBox from "@/components/common/astro/ui/AlertBox.astro";
import { validateInternalReturnPath } from "@/utils/security";

const requestedReturnTo = Astro.url.searchParams.get("return_to");
const referer = Astro.request.headers.get("referer");
let refererReturnTo: string | null = null;
if (!requestedReturnTo && referer) {
  try {
    const refererUrl = new URL(referer);
    if (refererUrl.origin === Astro.url.origin) {
      refererReturnTo = `${refererUrl.pathname}${refererUrl.search}`;
    }
  } catch {
    refererReturnTo = null;
  }
}

const returnTo = validateInternalReturnPath(
  requestedReturnTo || refererReturnTo,
  Astro.url.origin,
);

// const { cookies, redirect } = Astro;

// Check for local app-specific cookies only
// const accessToken = cookies.get("sb-local-access-token");
// const refreshToken = cookies.get("sb-local-refresh-token");
// const providerToken = cookies.get("sb-local-provider-token");
// const providerRefreshToken = cookies.get("sb-local-provider-refresh-token");

// if (accessToken && refreshToken && providerToken && providerRefreshToken) {
//   return redirect("/");
// }
---

<Layout title="Account Setup - Link Game to Social Account">
  <AuthPageShell>
    <AuthPageHeader
      title="アカウント連携"
      description="FUSOU-APP のゲーム識別子を、Web アカウントに関連付けます。"
    />

    <AuthPageSection
      title="連携ステップ"
      description="ゲーム識別子の同期、Google 認証、関連付け完了の順に進みます。"
    >
      <AuthLinkSteps />
    </AuthPageSection>

      <!-- Step Content -->
      <div class="rounded-lg border border-base-300 bg-base-100 p-6">
        <!-- Step 1: Sync game identifier -->
        <div id="step-1-content" class="step-content">
          <h2 class="text-xl font-bold mb-3">ゲーム識別子を同期</h2>
          <p class="text-sm text-base-content/70 mb-4 leading-relaxed">
            FUSOU-APP からゲームの `member_id` を受け取り、公開用のランダム UUID に置き換えて保存します。
          </p>

          <AlertBox type="info" title="識別子の扱い" class="mb-4 text-sm">
            これは Web アカウントと識別子を関連付ける処理であり、ゲームアカウントの厳密な本人確認を行うものではありません。
          </AlertBox>

          <button
            id="sync_member_id_button"
            class="btn btn-primary w-full mb-4"
          >
            <svg
              class="w-5 h-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
            FUSOUアプリと同期
          </button>

          <div id="sync_success" class="hidden mb-4">
            <AlertBox type="success" title="同期しました" class="text-sm">
              ゲーム識別子を同期しました。公開用 UUID として管理されます。
              <div id="member_id_display" class="mt-1 text-xs font-mono opacity-70"></div>
            </AlertBox>
          </div>

          <div id="sync_error" class="hidden mb-4">
            <AlertBox type="error" title="同期に失敗しました" class="text-sm">
              <p>
                FUSOUアプリが起動していることを確認し、「もう一度同期」ボタンを押してください。
              </p>
              <p id="error_message" class="mt-2"></p>
            </AlertBox>
          </div>
        </div>

        <!-- Step 2: Authenticate Web account -->
        <div id="step-2-content" class="step-content hidden">
          <h2 class="text-xl font-bold mb-3">Googleアカウント認証</h2>
          <p class="text-sm text-base-content/70 mb-4">
            Google アカウントで認証し、同期したゲーム識別子を Web アカウントに関連付けます。
          </p>

          <AlertBox type="info" title="Google認証について" class="mb-4 text-sm">
            Google 認証は Web アカウントの認証に使用します。ゲームアカウントの本人確認を意味しません。
          </AlertBox>

          <form action="/api/local_auth/signin" method="post" class="mb-4">
            <input
              type="hidden"
              name="app_origin"
              value={Astro.url.searchParams.get("app_origin") ?? ""}
            />
            <input type="hidden" name="return_to" value={returnTo} />
            <button
              id="local-signin-google-btn"
              type="submit"
              name="provider"
              value="google"
              class="btn btn-primary h-12 w-full flex items-center gap-2 font-semibold"
            >
              <svg
                aria-label="Google logo"
                width="20"
                height="20"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
              >
                <g>
                  <path d="m0 0H512V512H0" fill="#fff"></path>
                  <path
                    fill="#34a853"
                    d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"
                  ></path>
                  <path
                    fill="#4285f4"
                    d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"
                  ></path>
                  <path
                    fill="#fbbc02"
                    d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path>
                  <path
                    fill="#ea4335"
                    d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"
                  ></path>
                </g>
              </svg>
              <span>Googleで連携</span>
            </button>
          </form>

          <button
            id="back_to_step_1"
            class="btn btn-ghost w-full"
          >
            ← 前のステップへ戻る
          </button>
        </div>

        <!-- Step 3: Association complete -->
        <div id="step-3-content" class="step-content hidden">
          <h2 class="text-xl font-bold mb-3">関連付けが完了しました</h2>
          <p class="text-sm text-base-content/70 mb-4">
            ゲーム識別子と Web アカウントの関連付けが完了しました。複数の端末から同じ dataset を利用できます。
          </p>

          <AlertBox type="info" title="本人確認について" class="mb-4 text-sm">
            この関連付けはゲームアカウントの厳密な本人確認ではありません。
          </AlertBox>

          <button
            onclick="window.location.href = '/dashboard'"
            class="btn btn-primary w-full"
          >
            → ダッシュボードへ進む
          </button>
        </div>
      </div>
  </AuthPageShell>

  <script>
    import { syncPublicIdWithApp } from "@/lib/realtime-sync";

    // Type declaration for window.showStep
    declare global {
      interface Window {
        showStep: (step: string) => void;
      }
    }

    const steps = ["1", "2", "3"];
    let currentStep = "1";

    function maskPublicId(publicId: string) {
      if (!publicId || publicId.length < 8) return publicId;
      return publicId.substring(0, 6) + "..." + publicId.substring(publicId.length - 4);
    }

    function updateStepIndicators(step: string) {
      const stepNum = parseInt(step);

      function createStatusIcon(pathData: string): SVGSVGElement {
        const svgNs = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNs, "svg");
        svg.setAttribute("class", "w-5 h-5");
        svg.setAttribute("fill", "none");
        svg.setAttribute("stroke", "currentColor");
        svg.setAttribute("viewBox", "0 0 24 24");

        const path = document.createElementNS(svgNs, "path");
        path.setAttribute("stroke-linecap", "round");
        path.setAttribute("stroke-linejoin", "round");
        path.setAttribute("stroke-width", "3");
        path.setAttribute("d", pathData);
        svg.appendChild(path);
        return svg;
      }

      function setElementContent(element: Element, content: string | Node) {
        if (typeof content === "string") {
          element.textContent = content;
          return;
        }
        element.replaceChildren(content);
      }

      // Update step 1
      const step1Box = document.querySelector(".step-1-box");
      const step1Circle = document.querySelector(".step-1-circle");
      if (step1Box && step1Circle) {
        if (stepNum === 1) {
          step1Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-1-box border-primary bg-primary/10";
          step1Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-1-circle bg-primary text-primary-content";
        } else if (stepNum > 1) {
          step1Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-1-box border-success bg-success/10";
          step1Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-1-circle bg-success text-success-content";
          setElementContent(step1Circle, createStatusIcon("M5 13l4 4L19 7"));
        }
      }

      // Update step 2
      const step2Box = document.querySelector(".step-2-box");
      const step2Circle = document.querySelector(".step-2-circle");
      if (step2Box && step2Circle) {
        if (stepNum === 2) {
          step2Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-2-box border-primary bg-primary/10";
          step2Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-2-circle bg-primary text-primary-content";
        } else if (stepNum > 2) {
          step2Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-2-box border-success bg-success/10";
          step2Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-2-circle bg-success text-success-content";
          setElementContent(step2Circle, createStatusIcon("M5 13l4 4L19 7"));
        } else {
          step2Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-2-box border-transparent bg-base-200 opacity-50";
          step2Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-2-circle bg-base-300 text-base-content";
          setElementContent(step2Circle, "2");
        }
      }

      // Update step 3
      const step3Box = document.querySelector(".step-3-box");
      const step3Circle = document.querySelector(".step-3-circle");
      if (step3Box && step3Circle) {
        if (stepNum === 3) {
          step3Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-3-box border-success bg-success/10";
          step3Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-3-circle bg-success text-success-content";
          setElementContent(step3Circle, createStatusIcon("M5 13l4 4L19 7"));
        } else {
          step3Box.className =
            "flex h-20 w-full min-w-0 items-center gap-3 rounded-lg border-2 p-3 transition-all duration-200 step-3-box border-transparent bg-base-200 opacity-50";
          step3Circle.className =
            "shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold step-3-circle bg-base-300 text-base-content";
          setElementContent(step3Circle, "3");
        }
      }
    }

    // Make showStep globally accessible
    window.showStep = function (step) {
      if (steps.includes(step)) {
        currentStep = step;

        // Hide all step contents
        document.querySelectorAll(".step-content").forEach((el) => {
          el.classList.add("hidden");
        });

        // Show selected step content
        const stepContent = document.getElementById(`step-${step}-content`);
        if (stepContent) {
          stepContent.classList.remove("hidden");
        }

        // Update step indicators
        updateStepIndicators(step);

        // Update step buttons state
        document.querySelectorAll(".step-indicator").forEach((btn) => {
          const btnStep = btn.getAttribute("data-step");
          if (!btnStep) return;
          const stepNum = parseInt(btnStep);
          const currentNum = parseInt(step);

          if (stepNum < currentNum) {
            btn.removeAttribute("disabled");
          } else if (stepNum === currentNum) {
            btn.setAttribute("disabled", "");
          } else {
            btn.setAttribute("disabled", "");
          }
        });

        // Scroll to top
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    };

    function nextStep() {
      if (currentStep === "1") {
        window.showStep("2");
      } else if (currentStep === "2") {
        window.showStep("3");
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      function createButtonIcon(pathData: string): SVGSVGElement {
        const svgNs = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNs, "svg");
        svg.setAttribute("xmlns", svgNs);
        svg.setAttribute("class", "w-5 h-5");
        svg.setAttribute("fill", "none");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("stroke", "currentColor");

        const path = document.createElementNS(svgNs, "path");
        path.setAttribute("stroke-linecap", "round");
        path.setAttribute("stroke-linejoin", "round");
        path.setAttribute("stroke-width", "2");
        path.setAttribute("d", pathData);
        svg.appendChild(path);
        return svg;
      }

      function createLoadingSpinner(): HTMLSpanElement {
        const spinner = document.createElement("span");
        spinner.className = "loading loading-spinner loading-sm";
        return spinner;
      }

      function cloneChildNodes(element: HTMLElement): Node[] {
        return Array.from<Node>(element.childNodes).map((node: Node) =>
          node.cloneNode(true),
        );
      }

      function restoreButtonContent(
        button: HTMLButtonElement,
        originalNodes: Node[],
      ) {
        button.replaceChildren(
          ...originalNodes.map((node: Node) => node.cloneNode(true)),
        );
      }

      function setButtonLoading(button: HTMLButtonElement) {
        button.replaceChildren(
          createLoadingSpinner(),
          document.createTextNode(" Syncing..."),
        );
      }

      function setButtonSuccess(button: HTMLButtonElement) {
        button.replaceChildren(
          createButtonIcon("M5 13l4 4L19 7"),
          document.createTextNode(" Game Identifier Synced"),
        );
      }

      function setButtonRetry(button: HTMLButtonElement) {
        button.replaceChildren(
          createButtonIcon("M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"),
          document.createTextNode(" もう一度同期"),
        );
      }

      // Step buttons - prevent default click on disabled items
      document.querySelectorAll(".step-indicator").forEach((btn) => {
        btn.addEventListener("click", () => {
          const step = btn.getAttribute("data-step");
          const isDisabled = btn.getAttribute("disabled") !== null;

          if (!isDisabled && step) {
            window.showStep(step);
          }
        });
      });

      // Sync Member ID
      const syncButton = document.getElementById(
        "sync_member_id_button",
      ) as HTMLButtonElement | null;
      const syncSuccess = document.getElementById("sync_success");
      const syncError = document.getElementById("sync_error");
      const errorMessage = document.getElementById("error_message");

      if (syncButton) {
        syncButton.addEventListener("click", async () => {
          // Clear any previous loading state
          syncButton.classList.remove("loading", "btn-success");
          if (syncButton instanceof HTMLButtonElement) {
            syncButton.disabled = true;
          }
          syncSuccess?.classList.add("hidden");
          syncError?.classList.add("hidden");

          // Store original content
          const originalNodes = cloneChildNodes(syncButton);

          // Update button to show loading state
          setButtonLoading(syncButton);

          try {
            const result = await syncPublicIdWithApp(10000);

            if (result.success && result.publicId) {
              syncSuccess?.classList.remove("hidden");
              syncButton.classList.remove("btn-primary");
              syncButton.classList.add("btn-success");
              setButtonSuccess(syncButton);
              if (syncButton instanceof HTMLButtonElement) {
                syncButton.disabled = true;
              }

              // Display the server-generated public ID.
              const memberIdDisplay =
                document.getElementById("member_id_display");
              if (memberIdDisplay) {
                memberIdDisplay.textContent =
                  "Public ID: " + maskPublicId(result.publicId);
              }

              // Auto-advance to step 2 after 2 seconds
              setTimeout(() => {
                nextStep();
              }, 2000);
            } else {
              const msg =
                result.error || "Failed to sync with game. Please try again.";
              if (errorMessage) errorMessage.textContent = msg;
              if (syncError) syncError.classList.remove("hidden");

              restoreButtonContent(syncButton, originalNodes);
              syncButton.classList.add("btn-primary");
              setButtonRetry(syncButton);
              syncButton.disabled = false;
            }
          } catch (err) {
            const msg =
              err instanceof Error
                ? err.message
                : "An unexpected error occurred";
            if (errorMessage) errorMessage.textContent = msg;
            if (syncError) syncError.classList.remove("hidden");

            restoreButtonContent(syncButton, originalNodes);
            syncButton.classList.add("btn-primary");
            setButtonRetry(syncButton);
            syncButton.disabled = false;
          }
        });
      }

      // Back to Step 1
      const backToStep1 = document.getElementById("back_to_step_1");
      if (backToStep1) {
        backToStep1.addEventListener("click", () => {
          window.showStep("1");
        });
      }

      // Initialize
      window.showStep("1");
    });
  </script>
</Layout>
