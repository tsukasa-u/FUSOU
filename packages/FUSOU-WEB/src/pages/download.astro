---
import "@/assets/app.css";
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/common/astro/layout/Navigation.astro";
import PageShell from "@/components/common/astro/ui/PageShell.astro";
import PageHeader from "@/components/common/astro/ui/PageHeader.astro";

const releaseBase =
  "https://github.com/tsukasa-u/FUSOU/releases/latest/download";
const releasePage = "https://github.com/tsukasa-u/FUSOU/releases/latest";

const downloadData = {
  windows: {
    name: "Windows",
    label: "Windows 版をダウンロード",
    sub: "MSI インストーラー (x64) • 自動アップデート対応",
    url: `${releaseBase}/fusou-windows-x64.msi`,
  },
  macos: {
    name: "macOS",
    label: "macOS 版をダウンロード",
    sub: "ユニバーサル DMG (Intel & Apple Silicon 共通)",
    url: `${releaseBase}/fusou-darwin.dmg`,
  },
  linux: {
    name: "Linux",
    label: "Linux 版をダウンロード",
    sub: "AppImage (x64) • 主要ディストリビューション対応",
    url: `${releaseBase}/fusou-linux-amd64.AppImage`,
  },
  unknown: {
    name: "お使いのOS",
    label: "GitHub リリース一覧を開く",
    sub: "利用可能な全プラットフォーム・アーキテクチャ一覧",
    url: releasePage,
  },
};
