---
import type { MarkdownInstance } from "astro";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { compareSegments } from "@/utils/page_sorter";

const rawPostsGlobResult = import.meta.glob("@docs/**/*.md", {
  eager: true,
});
const rawPosts = Object.values(
  rawPostsGlobResult,
).reverse() as MarkdownInstance<Record<string, unknown>>[];

const normalizeSlug = (value: unknown) =>
  (typeof value === "string" ? value : "")
    .replace(/^\/+|\/+$/g, "")
    .replace(/^docs\//, "");

const formatSegment = (segment: string) =>
  segment
    .split(/[-_]/g)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");

type DocItem = {
  slug: string;
  category: string;
  categoryLabel: string;
  categoryOrder: number;
  categoryIcon: string;
  title: string;
  description: string;
  url: string;
  tags?: string[];
  isExternal?: boolean;
};

const CATEGORY_MAP: Record<
  string,
  { label: string; order: number; icon: string; description: string }
> = {
  start: {
    label: "Getting Started",
    order: 1,
    icon: "rocket_launch",
    description: "FUSOU の導入、概要、最初のセットアップガイド",
  },
  formulas: {
    label: "Formulas & Verification",
    order: 2,
    icon: "science",
    description: "艦これ検証式の一次情報源、探索パイプライン、追試・倫理規定",
  },
  guide: {
    label: "Guides & Features",
    order: 3,
    icon: "menu_book",
    description: "API、アセット同期、CLI、ダッシュボードの機能解説",
  },
  schema: {
    label: "API & Specifications",
    order: 4,
    icon: "schema",
    description: "API スキーマ定義およびデータ構造リファレンス",
  },
  "design-system": {
    label: "Design System",
    order: 5,
    icon: "palette",
    description: "UI コンポーネントカタログとデザインプリミティブ",
  },
  policy: {
    label: "Policies & Legal",
    order: 6,
    icon: "policy",
    description: "著作権、引用指針、コミュニティ倫理ポリシー",
  },
};

const docs: DocItem[] = rawPosts
  .map((post) => {
    const slug = normalizeSlug(post.frontmatter?.["slug"]);
    const segments = slug.split("/").filter(Boolean);
    if (segments.length === 0) return null;

    const catKey = segments[0] || "other";
    const catConfig = CATEGORY_MAP[catKey] ?? {
      label: formatSegment(catKey),
      order: 99,
      icon: "article",
      description: "",
    };

    return {
      slug,
      category: catKey,
      categoryLabel: catConfig.label,
      categoryOrder: catConfig.order,
      categoryIcon: catConfig.icon,
      title: (post.frontmatter?.["title"] as string) ?? formatSegment(segments.at(-1)!),
      description: (post.frontmatter?.["description"] as string) ?? "",
      url: `/docs/${slug}`,
      tags: (post.frontmatter?.["tags"] as string[]) ?? [],
    };
  })
  .filter(Boolean) as DocItem[];

const allDocs: DocItem[] = [
  ...docs,
  {
    slug: "schema/api-schema-explorer",
    category: "schema",
    categoryLabel: CATEGORY_MAP["schema"].label,
    categoryOrder: CATEGORY_MAP["schema"].order,
    categoryIcon: CATEGORY_MAP["schema"].icon,
    title: "API Schema Explorer",
    description: "インタラクティブな API スキーマビューアーと型定義",
    url: "/docs/api-schema",
    tags: ["api", "schema", "avro"],
    isExternal: true,
  },
  {
    slug: "design-system/catalog",
    category: "design-system",
    categoryLabel: CATEGORY_MAP["design-system"].label,
    categoryOrder: CATEGORY_MAP["design-system"].order,
    categoryIcon: CATEGORY_MAP["design-system"].icon,
    title: "Component Catalog",
    description: "FUSOU デザインシステムの UI コンポーネント一覧とプレビュー",
    url: "/design-system",
    tags: ["ui", "components", "design"],
    isExternal: true,
  },
];

// Group by category
const groupedCategories = Object.entries(CATEGORY_MAP)
  .map(([key, config]) => {
    const categoryDocs = allDocs
      .filter((d) => d.category === key)
      .sort((a, b) => compareSegments(a.slug.split("/"), b.slug.split("/")));
    return {
      key,
      ...config,
      docs: categoryDocs,
    };
  })
  .filter((cat) => cat.docs.length > 0)
  .sort((a, b) => a.order - b.order);

const totalDocsCount = allDocs.length;
const totalCategoriesCount = groupedCategories.length;
---

<DocsLayout title="Documentation Index - FUSOU" description="FUSOU ドキュメントインデックス">
  <div class="space-y-10">
    <!-- Hero Header -->
    <section class="relative overflow-hidden rounded-2xl border border-base-300/70 bg-gradient-to-b from-base-100 to-base-200/40 p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Documentation Index
        </span>
        <span class="text-xs text-base-content/50">•</span>
        <span class="text-xs text-base-content/60 font-medium">{totalDocsCount} documents across {totalCategoriesCount} sections</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-base-content tracking-tight">
        FUSOU Documentation
      </h1>
      <p class="mt-3 text-base sm:text-lg text-base-content/70 max-w-[70ch] leading-relaxed">
        艦これデータ検証、シミュレーションエンジン、API、および FUSOU エコシステムの全ドキュメント一覧です。
      </p>

      <!-- Search Input -->
      <div class="mt-6 max-w-xl">
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-base-content/45 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            id="docs-index-search"
            type="search"
            placeholder="Search by title, topic, or keyword (e.g., formula, api, night battle)..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-base-300 bg-base-100 text-sm text-base-content placeholder:text-base-content/45 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all shadow-sm"
          />
        </div>
        <p id="search-status" class="mt-2 text-xs text-base-content/55 hidden"></p>
      </div>
    </section>

    <!-- Category Sections -->
    <div id="docs-categories-container" class="space-y-10">
      {
        groupedCategories.map((cat) => (
          <section class="doc-category-section" data-category={cat.key}>
            <div class="flex items-center gap-2 mb-2 pb-2 border-b border-base-300/60">
              <h2 class="text-lg sm:text-xl font-bold text-base-content flex items-center gap-2">
                <span>{cat.label}</span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-base-300/60 text-base-content/70">
                  {cat.docs.length}
                </span>
              </h2>
            </div>
            {cat.description && (
              <p class="text-xs sm:text-sm text-base-content/65 mb-4">{cat.description}</p>
            )}

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3.5">
              {cat.docs.map((doc) => (
                <a
                  href={doc.url}
                  class="doc-card group relative flex flex-col justify-between p-4 rounded-xl border border-base-300/70 bg-base-100/80 hover:bg-base-100 hover:border-primary/70 hover:shadow-sm hover:shadow-md transition-all"
                  data-doc-card
                  data-title={doc.title.toLowerCase()}
                  data-desc={doc.description.toLowerCase()}
                  data-tags={(doc.tags || []).join(" ").toLowerCase()}
                >
                  <div>
                    <div class="flex items-start justify-between gap-2">
                      <h3 class="text-sm font-bold text-base-content group-hover-text-brand transition-colors leading-snug">
                        {doc.title}
                      </h3>
                      {doc.isExternal ? (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-base-content/40 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-base-content/30 group-hover-text-brand group-hover:translate-x-0.5 shrink-0 mt-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      )}
                    </div>
                    {doc.description && (
                      <p class="mt-2 text-xs text-base-content/65 line-clamp-2 leading-relaxed">
                        {doc.description}
                      </p>
                    )}
                  </div>

                  {doc.tags && doc.tags.length > 0 && (
                    <div class="mt-3.5 pt-2.5 border-t border-base-300/40 flex flex-wrap gap-1">
                      {doc.tags.slice(0, 3).map((tag) => (
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-base-200 text-base-content/60 font-medium">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- Empty search message -->
    <div id="docs-search-none" class="hidden text-center py-12 rounded-xl border border-dashed border-base-300 p-8">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto text-base-content/30 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <p class="text-sm font-semibold text-base-content">No documents match your query</p>
      <p class="text-xs text-base-content/60 mt-1">Try searching for a different keyword or browse by category in the sidebar.</p>
    </div>
  </div>
</DocsLayout>

<script is:inline>
  const searchInput = document.getElementById("docs-index-search");
  const searchStatus = document.getElementById("search-status");
  const cards = Array.from(document.querySelectorAll("[data-doc-card]"));
  const sections = Array.from(document.querySelectorAll(".doc-category-section"));
  const emptyState = document.getElementById("docs-search-none");

  const filterDocs = () => {
    const q = (searchInput?.value || "").trim().toLowerCase();
    let totalVisible = 0;

    cards.forEach((card) => {
      const title = card.getAttribute("data-title") || "";
      const desc = card.getAttribute("data-desc") || "";
      const tags = card.getAttribute("data-tags") || "";
      const match = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
      card.classList.toggle("hidden", !match);
      if (match) totalVisible += 1;
    });

    // Toggle category sections if they have no visible cards
    sections.forEach((sec) => {
      const visibleCards = sec.querySelectorAll("[data-doc-card]:not(.hidden)");
      sec.classList.toggle("hidden", visibleCards.length === 0);
    });

    if (emptyState) {
      emptyState.classList.toggle("hidden", totalVisible > 0);
    }

    if (searchStatus) {
      if (q) {
        searchStatus.textContent = `Found ${totalVisible} document${totalVisible === 1 ? "" : "s"} matching "${q}"`;
        searchStatus.classList.remove("hidden");
      } else {
        searchStatus.classList.add("hidden");
      }
    }
  };

  searchInput?.addEventListener("input", filterDocs);
</script>
