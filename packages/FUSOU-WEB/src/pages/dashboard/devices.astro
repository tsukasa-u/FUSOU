---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";
import AlertBox from "@/components/common/astro/ui/AlertBox.astro";
import { createSupabaseServerClient } from "@/lib/supabaseServer";
import type { User } from "@supabase/supabase-js";
import { env as cfEnv } from "cloudflare:workers";

const cookies = Astro.cookies;
const runtimeEnv = cfEnv as unknown as Record<string, unknown>;
const supabase = createSupabaseServerClient(cookies, runtimeEnv);

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/auth/signin");
}

let user: User | null = null;
try {
  const session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    return Astro.redirect("/auth/signin");
  }

  user = session.data.user;
} catch (_error) {
  return Astro.redirect("/auth/signin");
}

if (!user) {
  return Astro.redirect("/auth/signin");
}

function providerInitial(provider?: string): string {
  return (provider?.trim()?.charAt(0) || "?").toUpperCase();
}
---
<Layout title="Device Management - FUSOU">
  <AuthPageShell>
    <AuthPageHeader
      title="Device Management"
      description="FUSOU-APPと連携した端末を確認・失効します。"
    />

    <div class="rounded-lg border border-base-300 bg-base-100 p-6">
      <AuthPageSection
        title="端末の登録条件"
        description="匿名同期の端末一覧に表示される条件を確認します。"
      >
        <AlertBox type="info" title="When devices are registered" class="text-sm">
          Devices are registered on this page when FUSOU-APP syncs a dataset. If a device does not appear, complete FUSOU-APP linking and Google authentication, then sync again in the app.
        </AlertBox>
      </AuthPageSection>

      <AuthPageSection
        title="現在のアカウント"
        description="端末同期に使うアカウントを確認し、端末情報を更新します。"
        class="mt-6"
      >
        <div
          class="p-4 bg-base-200 rounded-lg flex items-center justify-between"
        >
          <div class="flex items-center gap-3">
            <span
              class="size-10 rounded-full bg-base-300 text-base-content font-bold text-sm grid place-items-center"
              title={user.app_metadata.provider || "provider"}
            >
              {providerInitial(user.app_metadata.provider)}
            </span>
            <div>
              <div class="font-bold text-sm">
                {user.user_metadata?.["name"] || "User"}
              </div>
              <div class="text-xs opacity-60 font-mono">{user.email}</div>
            </div>
          </div>

          <button
            id="refresh-devices-btn"
            class="btn btn-sm btn-ghost border border-base-300"
            type="button"
          >
            Refresh
          </button>
        </div>
      </AuthPageSection>

      <AuthPageSection
        title="Anonymous Sync Devices"
        description="使用中の端末を失効できます。失効した端末は次回同期時に再登録が必要です。"
        class="mt-6"
      >
          <div id="anon-devices-list" class="space-y-2">
            <div class="text-center py-4 text-base-content/60">Loading...</div>
          </div>
      </AuthPageSection>

    </div>
  </AuthPageShell>
</Layout>

<dialog id="revoke-modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg">Confirm Revoke</h3>
    <p class="py-4" id="revoke-modal-message">
      この端末を失効します。よろしいですか？
    </p>
    <div class="modal-action">
      <button class="btn border border-base-300" id="revoke-modal-cancel"
        >Cancel</button
      >
      <button
        class="btn btn-error bg-error-content text-error border border-error hover:bg-error hover:text-error-content"
        id="revoke-modal-confirm">Revoke</button
      >
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  const ANON_V2_BASE = "/api/auth/anonymous-sync/v2/devices";
  type AnonymousDevice = {
    device_id: string | number;
    pid_masked?: string | null;
    created_at?: string | null;
    last_seen_at?: string | null;
    revoked_at?: string | null;
    revoked_reason?: string | null;
  };

  let pendingRevokeAction: (() => void | Promise<void>) | null = null;

  function isRecord(value: unknown): value is Record<string, unknown> {
    return value !== null && typeof value === "object" && !Array.isArray(value);
  }

  function byId<T extends HTMLElement = HTMLElement>(id: string): T {
    const element = document.getElementById(id);
    if (!element) throw new Error(`Missing expected element: ${id}`);
    return element as T;
  }

  function parseAnonymousDevices(value: unknown): AnonymousDevice[] {
    if (!Array.isArray(value)) return [];
    return value.flatMap((item) => {
      if (!isRecord(item)) return [];
      const deviceId = item["device_id"];
      if (typeof deviceId !== "string" && typeof deviceId !== "number") {
        return [];
      }
      return [
        {
          device_id: deviceId,
          pid_masked:
            typeof item["pid_masked"] === "string" ? item["pid_masked"] : null,
          created_at:
            typeof item["created_at"] === "string" ? item["created_at"] : null,
          last_seen_at:
            typeof item["last_seen_at"] === "string"
              ? item["last_seen_at"]
              : null,
          revoked_at:
            typeof item["revoked_at"] === "string" ? item["revoked_at"] : null,
          revoked_reason:
            typeof item["revoked_reason"] === "string"
              ? item["revoked_reason"]
              : null,
        },
      ];
    });
  }

  function showRevokeModal(
    message: string,
    onConfirm: () => void | Promise<void>,
  ) {
    const modal = byId<HTMLDialogElement>("revoke-modal");
    byId("revoke-modal-message").textContent = message;
    pendingRevokeAction = onConfirm;
    modal.showModal();
  }

  function setContainerMessage(
    containerId: string,
    message: string,
    className = "text-center py-4 text-base-content/60",
  ) {
    const container = byId(containerId);
    const div = document.createElement("div");
    div.className = className;
    div.textContent = message;
    container.replaceChildren(div);
  }

  function createDangerButton(
    title: string,
    onClick: () => void | Promise<void>,
  ): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "btn btn-sm btn-ghost btn-error border border-error-content";
    button.title = title;
    button.textContent = "Revoke";
    button.addEventListener("click", () => {
      void onClick();
    });
    return button;
  }

  function formatDate(dateStr: string | null | undefined) {
    if (!dateStr) return "N/A";
    const date = new Date(dateStr);
    return date.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function renderAnonymousDevices(devices: AnonymousDevice[]) {
    const container = byId("anon-devices-list");
    if (devices.length === 0) {
      setContainerMessage(
        "anon-devices-list",
        "No anonymous sync devices found.",
      );
      return;
    }

    container.replaceChildren();

    devices.forEach((device) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between p-3 bg-base-200 rounded-md";
      row.dataset["deviceId"] = String(device.device_id);

      const content = document.createElement("div");
      content.className = "flex-1 min-w-0";

      const title = document.createElement("div");
      title.className = "font-medium font-mono text-sm";
      title.textContent = String(device.device_id ?? "");

      const pid = document.createElement("div");
      pid.className = "text-sm text-base-content/60 font-mono";
      pid.textContent = `PID: ${String(device.pid_masked ?? "")}`;

      const active = !device.revoked_at;
      const meta = document.createElement("div");
      meta.className = "text-xs text-base-content/40";
      meta.textContent = active
        ? `Active · Added ${formatDate(device.created_at)}${device.last_seen_at ? ` · Last seen ${formatDate(device.last_seen_at)}` : ""}`
        : `Revoked ${formatDate(device.revoked_at)}${device.revoked_reason ? ` · ${String(device.revoked_reason)}` : ""}`;

      content.appendChild(title);
      content.appendChild(pid);
      content.appendChild(meta);
      row.appendChild(content);

      if (active) {
        const deviceId = String(device.device_id ?? "");
        const button = createDangerButton(
          "Revoke Anonymous Sync Device",
          () => {
            showRevokeModal(
              "この端末を失効します。次回同期時に再登録が必要になります。よろしいですか？",
              () => revokeAnonymousDevice(deviceId),
            );
          },
        );
        row.appendChild(button);
      }

      container.appendChild(row);
    });
  }

  async function fetchAnonymousDevices() {
    try {
      const response = await fetch(`${ANON_V2_BASE}?include_revoked=true`);

      if (response.status === 204) {
        renderAnonymousDevices([]);
        return;
      }

      const data: unknown = await response.json();
      if (response.ok && isRecord(data)) {
        renderAnonymousDevices(parseAnonymousDevices(data["devices"]));
      } else {
        setContainerMessage(
          "anon-devices-list",
          "Failed to load anonymous sync devices",
          "text-center py-4 text-error",
        );
      }
    } catch (error) {
      setContainerMessage(
        "anon-devices-list",
        "Failed to load anonymous sync devices",
        "text-center py-4 text-error",
      );
    }
  }

  async function revokeAnonymousDevice(deviceId: string) {
    try {
      const response = await fetch(`${ANON_V2_BASE}/${deviceId}`, {
        method: "DELETE",
      });

      if (response.ok || response.status === 204) {
        await fetchAnonymousDevices();
      }
    } catch (error) {
      console.error("Failed to revoke anonymous sync device", error);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    fetchAnonymousDevices();

    byId("refresh-devices-btn").addEventListener("click", () => {
      void fetchAnonymousDevices();
    });

    byId("revoke-modal-cancel")
      .addEventListener("click", () => {
        byId<HTMLDialogElement>("revoke-modal").close();
        pendingRevokeAction = null;
      });

    byId("revoke-modal-confirm")
      .addEventListener("click", async () => {
        byId<HTMLDialogElement>("revoke-modal").close();
        if (pendingRevokeAction) {
          await pendingRevokeAction();
          pendingRevokeAction = null;
        }
      });
  });
</script>
