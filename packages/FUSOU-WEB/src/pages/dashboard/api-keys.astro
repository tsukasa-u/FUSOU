---
import Layout from "@/layouts/Layout.astro";
import AuthPageHeader from "@/components/common/astro/layout/AuthPageHeader.astro";
import AuthPageShell from "@/components/common/astro/layout/AuthPageShell.astro";
import AuthPageSection from "@/components/common/astro/layout/AuthPageSection.astro";
import AlertBox from "@/components/common/astro/ui/AlertBox.astro";
import { createSupabaseServerClient } from "@/lib/supabaseServer";
import type { User } from "@supabase/supabase-js";
import { env as cfEnv } from "cloudflare:workers";

const cookies = Astro.cookies;
const runtimeEnv = cfEnv as unknown as Record<string, unknown>;
const supabase = createSupabaseServerClient(cookies, runtimeEnv);

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/auth/signin");
}

let user: User | null = null;
try {
  const session = await supabase.auth.setSession({
    refresh_token: refreshToken.value,
    access_token: accessToken.value,
  });
  if (session.error) {
    return Astro.redirect("/auth/signin");
  }
  user = session.data.user;
} catch (_error) {
  return Astro.redirect("/auth/signin");
}

let memberMap: {
  linked?: boolean;
  member_id_hash_masked?: string;
  source?: string;
} | null = null;
function providerInitial(provider?: string): string {
  return (provider?.trim()?.charAt(0) || "?").toUpperCase();
}

try {
  const memberMapResponse = await fetch(
    new URL("/api/user/member-map", Astro.url.origin),
    {
      headers: {
        Cookie: Astro.request.headers.get("cookie") ?? "",
      },
    },
  );

  const memberMapData = (await memberMapResponse.json()) as {
    ok?: boolean;
    linked?: boolean;
    map?: {
      linked?: boolean;
      member_id_hash_masked?: string;
      source?: string;
    } | null;
    error?: string;
  };
  if (memberMapResponse.ok && memberMapData?.ok && memberMapData?.map?.linked) {
    memberMap = memberMapData.map;
  } else if (!memberMapResponse.ok) {
    console.error("Member ID Check Failed:", memberMapData);
  }
} catch (e) {
  console.error("Member ID Check Failed (Exception):", e);
}

if (!user) {
  return Astro.redirect("/auth/signin");
}
---

<Layout title="API Keys - FUSOU">
  <AuthPageShell>
    <AuthPageHeader
      title="API Key Management"
      description="fusou-datasetsで使うAPIキーを管理します。"
    />

    <div class="rounded-lg border border-base-300 bg-base-100 p-6">
      <AuthPageSection
        title="利用開始前の確認"
        description="APIキーを作成する前に、次の準備を完了してください。"
      >
          <AlertBox type="info" title="Before using datasets" class="mb-5 text-sm">
            <ol class="list-decimal space-y-1 pl-5">
              <li>Sync your game account with FUSOU-APP.</li>
              <li>Authenticate with Google. FUSOU-APP linking and web sign-in will complete together.</li>
              <li>Create an API key on this page and use it with fusou-datasets.</li>
            </ol>
            <p class="mt-3 text-xs opacity-75">
              If your game account is not linked, complete FUSOU-APP linking first.
            </p>
          </AlertBox>
      </AuthPageSection>

      <AuthPageSection
        title="アカウント情報"
        description="サインイン中のアカウントとゲームアカウントの連携状態を確認します。"
        class="mt-6"
      >
        <div
          class="p-4 bg-base-200 rounded-lg flex items-center justify-between"
        >
          <div class="flex items-center gap-3">
            <span
              class="size-10 rounded-full bg-base-300 text-base-content font-bold text-sm grid place-items-center"
              title={user.app_metadata.provider || "provider"}
            >
              {providerInitial(user.app_metadata.provider)}
            </span>
            <div>
              <div class="font-bold text-sm">
                {user.user_metadata?.["name"] || "User"}
              </div>
              <div class="text-xs opacity-60 font-mono">{user.email}</div>
            </div>
          </div>

          <div>
            {
              memberMap ? (
                <div class="flex items-center gap-2 px-3 py-1.5 bg-success/10 border border-success rounded-md text-success text-sm font-semibold">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Verified
                </div>
              ) : (
                <div
                  class="flex items-center gap-2 px-3 py-1.5 bg-warning/10 border border-warning rounded-md text-warning text-sm font-semibold"
                  title="Link Game Account"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <>
                      <circle cx="12" cy="12" r="10" />
                      <line x1="12" y1="8" x2="12" y2="12" />
                      <line x1="12" y1="16" x2="12.01" y2="16" />
                    </>
                  </svg>
                  Unverified
                </div>
              )
            }
          </div>
        </div>
      </AuthPageSection>

        {
          !memberMap && (
            <AuthPageSection
              title="ゲームアカウントの連携"
              description="APIキーを作成するには、先にゲームアカウントを連携してください。"
              class="mt-6"
            >
              <AlertBox type="warning" title="Game Account Verification Required" class="text-sm">
                <p>
                  You must link your KanColle game account to create API keys.
                </p>
                <a href="/auth/local/signin?return_to=%2Fdashboard%2Fapi-keys" class="btn btn-sm btn-warning btn-outline mt-3">
                  Link Account →
                </a>
              </AlertBox>
            </AuthPageSection>
          )
        }

      <AuthPageSection
        title="Resource Units (RU)"
        description="APIリクエストに利用できるリソース残量を確認します。"
        class="mt-6"
      >
        <div class="p-4 bg-base-200/50 rounded-lg">
          <div class="flex justify-between items-center mb-2">
            <span id="ru-status-text" class="text-xs font-mono font-bold"
              >Checking...</span
            >
          </div>
          <progress
            id="ru-progress"
            class="progress progress-primary w-full"
            value="0"
            max="1000"></progress>
          <p class="text-xs text-base-content/50 mt-2 text-right">
            Refills automatically at 10 RU/sec. Max 1000.
          </p>
        </div>
      </AuthPageSection>

      <AuthPageSection
        title="API Keys"
        description="fusou-datasetsで使うAPIキーの作成・コピー・削除を行います。"
        class="mt-6"
      >
          <div class="flex justify-between items-center mb-4">
            <button
              id="create-key-btn"
              class="btn btn-sm btn-primary border border-primary-content"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              Create New Key
            </button>
          </div>

          <div id="api-keys-list" class="space-y-2">
            <div class="text-center py-4 text-base-content/60">Loading...</div>
          </div>

          <!-- Error Alert -->
          <div
            id="api-key-error"
            class="hidden alert alert-error mb-4 text-sm"
          >
          </div>

        <div
          id="new-key-display"
          class="hidden alert alert-success mb-8 items-start"
        >
          <div class="flex items-center gap-2 mb-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5 text-success"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span class="font-semibold text-success">API Key Created</span>
          </div>
          <p class="text-sm text-base-content/70 mb-2">
            Copy this key now. It will not be shown again.
          </p>
          <div class="flex gap-2">
            <code
              id="new-key-value"
              class="flex-1 bg-base-300 px-3 py-2 rounded text-sm font-mono break-all"
            ></code>
            <button
              id="copy-key-btn"
              class="btn btn-sm btn-ghost border border-base-300"
            >
              <!-- Copy icon -->
              <svg
                id="copy-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                ></path>
              </svg>
              <!-- Check icon (hidden by default) -->
              <svg
                id="check-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 hidden text-success"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </AuthPageSection>

      <AuthPageSection
        title="Trusted Devices"
        description="APIアクセスを許可した端末を確認します。"
        class="mt-6"
      >
          <div id="devices-list" class="space-y-2">
            <div class="text-center py-4 text-base-content/60">Loading...</div>
          </div>
      </AuthPageSection>

    </div>
  </AuthPageShell>
</Layout>

<!-- Delete Confirmation Modal -->
<dialog id="delete-modal" class="modal">
  <div class="modal-box">
    <h3 class="font-bold text-lg">Confirm Deletion</h3>
    <p class="py-4" id="delete-modal-message">
      Are you sure you want to delete this item?
    </p>
    <div class="modal-action">
      <button class="btn border border-base-300" id="delete-modal-cancel"
        >Cancel</button
      >
      <button
        class="btn btn-error bg-error-content text-error border border-error hover:bg-error hover:text-error-content"
        id="delete-modal-confirm">Delete</button
      >
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  import { copyToClipboard } from "@/utils/clipboard";

  const API_BASE = "/api/api-keys";

  type ApiKeyRow = {
    id: string | number;
    key_masked?: string | null;
    is_active?: boolean;
    created_at?: string | null;
  };

  type DeviceRow = {
    id: string | number;
    client_id_masked?: string | null;
    device_name?: string | null;
    created_at?: string | null;
    last_used_at?: string | null;
  };

  function isRecord(value: unknown): value is Record<string, unknown> {
    return value !== null && typeof value === "object" && !Array.isArray(value);
  }

  function parseApiKeyRows(value: unknown): ApiKeyRow[] {
    if (!Array.isArray(value)) return [];
    return value.flatMap((item) => {
      if (!isRecord(item)) return [];
      const id = item["id"];
      if (typeof id !== "string" && typeof id !== "number") return [];
      return [
        {
          id,
          key_masked:
            typeof item["key_masked"] === "string" ? item["key_masked"] : null,
          is_active:
            typeof item["is_active"] === "boolean" ? item["is_active"] : false,
          created_at:
            typeof item["created_at"] === "string" ? item["created_at"] : null,
        },
      ];
    });
  }

  function parseDeviceRows(value: unknown): DeviceRow[] {
    if (!Array.isArray(value)) return [];
    return value.flatMap((item) => {
      if (!isRecord(item)) return [];
      const id = item["id"];
      if (typeof id !== "string" && typeof id !== "number") return [];
      return [
        {
          id,
          client_id_masked:
            typeof item["client_id_masked"] === "string"
              ? item["client_id_masked"]
              : null,
          device_name:
            typeof item["device_name"] === "string" ? item["device_name"] : null,
          created_at:
            typeof item["created_at"] === "string" ? item["created_at"] : null,
          last_used_at:
            typeof item["last_used_at"] === "string" ? item["last_used_at"] : null,
        },
      ];
    });
  }

  function byId<T extends HTMLElement = HTMLElement>(id: string): T {
    const element = document.getElementById(id);
    if (!element) {
      throw new Error(`Missing expected element: ${id}`);
    }
    return element as T;
  }

  // Modal state
  let pendingDeleteAction: null | (() => void | Promise<void>) = null;

  // Modal helper
  function showDeleteModal(message: string, onConfirm: () => void | Promise<void>) {
    const modal = byId<HTMLDialogElement>("delete-modal");
    byId("delete-modal-message").textContent = message;
    pendingDeleteAction = onConfirm;
    modal.showModal();
  }

  function hideNewKeyDisplay() {
    byId("new-key-display").classList.add("hidden");
  }

  function setContainerMessage(
    containerId: string,
    message: string,
    className = "text-center py-4 text-base-content/60",
  ) {
    const container = byId(containerId);
    const div = document.createElement("div");
    div.className = className;
    div.textContent = message;
    container.replaceChildren(div);
  }

  function createDangerButton(
    title: string,
    pathD: string,
    onClick: () => void | Promise<void>,
  ): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "btn btn-sm btn-ghost btn-error border border-error-content";
    button.title = title;

    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
    svg.setAttribute("class", "size-4");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "2");

    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", pathD);
    svg.appendChild(path);
    button.appendChild(svg);
    button.addEventListener("click", () => {
      void onClick();
    });
    return button;
  }

  async function fetchApiKeys() {
    try {
      const response = await fetch(API_BASE);
      const data: unknown = await response.json();
      if (isRecord(data) && data["success"] === true) {
        renderApiKeys(parseApiKeyRows(data["api_keys"]));
      } else {
        setContainerMessage(
          "api-keys-list",
          "Failed to load API keys",
          "text-center py-4 text-error",
        );
      }
    } catch (error) {
      setContainerMessage(
        "api-keys-list",
        "Failed to load API keys",
        "text-center py-4 text-error",
      );
    }
  }

  async function fetchDevices() {
    try {
      const response = await fetch(`${API_BASE}/devices`);
      const data: unknown = await response.json();
      if (isRecord(data) && data["success"] === true) {
        renderDevices(parseDeviceRows(data["devices"]));
      } else {
        setContainerMessage(
          "devices-list",
          "Failed to load devices",
          "text-center py-4 text-error",
        );
      }
    } catch (error) {
      setContainerMessage(
        "devices-list",
        "Failed to load devices",
        "text-center py-4 text-error",
      );
    }
  }

  async function fetchUsage() {
    try {
      const response = await fetch(`${API_BASE}/usage`);
      const data: unknown = await response.json();
      if (
        isRecord(data) &&
        data["success"] === true &&
        isRecord(data["usage"]) &&
        typeof data["usage"]["remaining"] === "number" &&
        Number.isFinite(data["usage"]["remaining"])
      ) {
        const remaining = data["usage"]["remaining"];
        const progress = byId<HTMLProgressElement>("ru-progress");
        const text = byId("ru-status-text");

        progress.value = remaining;
        text.textContent = `${remaining} / 1000`;

        // Color logic
        if (remaining < 200) {
          progress.classList.remove("progress-primary");
          progress.classList.add("progress-error");
          text.classList.add("text-error");
        }
      }
    } catch (e) {
      console.error("Failed to fetch RU usage", e);
      byId("ru-status-text").textContent = "Error";
      byId("ru-status-text").classList.add("text-error");
    }
  }

  function renderApiKeys(keys: ApiKeyRow[]) {
    const container = byId("api-keys-list");
    if (keys.length === 0) {
      setContainerMessage(
        "api-keys-list",
        "No API keys yet. Create one to get started.",
      );
      return;
    }

    container.replaceChildren();
    keys.forEach((key) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between p-3 bg-base-200 rounded-md";
      row.dataset["keyId"] = String(key.id);

      const content = document.createElement("div");
      content.className = "flex-1 min-w-0";

      const masked = document.createElement("div");
      masked.className = "text-sm text-base-content/60 font-mono";
      masked.textContent = String(key.key_masked ?? "");

      const meta = document.createElement("div");
      meta.className = "text-xs text-base-content/40";
      meta.textContent = `${key.is_active ? "✓ Active" : "✗ Inactive"} · Created ${formatDate(key.created_at)}`;

      content.appendChild(masked);
      content.appendChild(meta);

      const keyId = String(key.id ?? "");
      const button = createDangerButton(
        "Delete API Key",
        "M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2",
        () => {
          showDeleteModal(
            "Are you sure you want to delete this API key? This action cannot be undone.",
            () => deleteApiKey(keyId),
          );
        },
      );

      row.appendChild(content);
      row.appendChild(button);
      container.appendChild(row);
    });
  }

  function renderDevices(devices: DeviceRow[]) {
    const container = byId("devices-list");
    if (devices.length === 0) {
      setContainerMessage("devices-list", "No trusted devices yet.");
      return;
    }

    container.replaceChildren();
    devices.forEach((device) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between p-3 bg-base-200 rounded-md";
      row.dataset["deviceId"] = String(device.id);

      const content = document.createElement("div");
      content.className = "flex-1 min-w-0";

      const name = document.createElement("div");
      name.className = "font-medium";
      name.textContent = String(device.device_name ?? "");

      const clientId = document.createElement("div");
      clientId.className = "text-sm text-base-content/60 font-mono";
      clientId.textContent = String(device.client_id_masked ?? "");

      const meta = document.createElement("div");
      meta.className = "text-xs text-base-content/40";
      meta.textContent = `Added ${formatDate(device.created_at)}${device.last_used_at ? ` · Last used ${formatDate(device.last_used_at)}` : ""}`;

      content.appendChild(name);
      content.appendChild(clientId);
      content.appendChild(meta);

      const deviceId = String(device.id ?? "");
      const button = createDangerButton(
        "Revoke Device",
        "M18 6L6 18M6 6l12 12",
        () => {
          showDeleteModal(
            "Are you sure you want to revoke this device? It will need to be re-verified.",
            () => revokeDevice(deviceId),
          );
        },
      );

      row.appendChild(content);
      row.appendChild(button);
      container.appendChild(row);
    });
  }

  async function createApiKey() {
    try {
      const response = await fetch(API_BASE, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({}),
      });
      const data: unknown = await response.json();
      const apiKey =
        isRecord(data) &&
        isRecord(data["api_key"]) &&
        typeof data["api_key"]["key"] === "string"
          ? data["api_key"]["key"]
          : null;
      if (isRecord(data) && data["success"] === true && apiKey) {
        // Show the new key
        const display = byId("new-key-display");
        const keyValue = byId("new-key-value");
        keyValue.textContent = apiKey;
        display.classList.remove("hidden");
        byId("api-key-error").classList.add("hidden");

        // Refresh the list
        await fetchApiKeys();
      } else {
        // Show error
        const errorDiv = byId("api-key-error");
        const message =
          isRecord(data) && typeof data["message"] === "string"
            ? data["message"]
            : isRecord(data) && typeof data["error"] === "string"
              ? data["error"]
              : "Failed to create key";
        errorDiv.textContent = message;
        errorDiv.classList.remove("hidden");
      }
    } catch (error) {
      console.error("Failed to create API key", error);
      const errorDiv = byId("api-key-error");
      errorDiv.textContent = "Network error or server unavailable";
      errorDiv.classList.remove("hidden");
    }
  }

  /** @param {string} keyId */
  async function deleteApiKey(keyId: string) {
    try {
      const response = await fetch(`${API_BASE}/${keyId}`, {
        method: "DELETE",
      });
      const data: unknown = await response.json();
      if (isRecord(data) && data["success"] === true) {
        hideNewKeyDisplay();
        await fetchApiKeys();
      }
    } catch (error) {
      console.error("Failed to delete API key", error);
    }
  }

  /** @param {string} deviceId */
  async function revokeDevice(deviceId: string) {
    try {
      const response = await fetch(`${API_BASE}/devices/${deviceId}`, {
        method: "DELETE",
      });
      const data: unknown = await response.json();
      if (isRecord(data) && data["success"] === true) {
        await fetchDevices();
      }
    } catch (error) {
      console.error("Failed to revoke device", error);
    }
  }

  /** @param {string | null | undefined} dateStr */
  function formatDate(dateStr: string | null | undefined) {
    if (!dateStr) return "N/A";
    const date = new Date(dateStr);
    return date.toLocaleDateString("ja-JP", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  // Initialize
  document.addEventListener("DOMContentLoaded", () => {
    fetchApiKeys();
    fetchDevices();
    fetchUsage();

    // Create key button
    byId("create-key-btn").addEventListener("click", createApiKey);

    // Copy key button - switch to check icon on success
    byId("copy-key-btn").addEventListener("click", async () => {
      const key = byId("new-key-value").textContent ?? "";
      const copyIcon = byId("copy-icon");
      const checkIcon = byId("check-icon");

      const success = await copyToClipboard(key);
      if (success) {
        // Switch icons
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");

        // Switch back after 2 seconds
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
        }, 2000);
      }
    });

    // Modal handlers
    byId("delete-modal-cancel").addEventListener("click", () => {
      byId<HTMLDialogElement>("delete-modal").close();
      pendingDeleteAction = null;
    });

    byId("delete-modal-confirm").addEventListener("click", async () => {
      byId<HTMLDialogElement>("delete-modal").close();
      if (pendingDeleteAction) {
        await pendingDeleteAction();
        pendingDeleteAction = null;
      }
    });
  });
</script>
