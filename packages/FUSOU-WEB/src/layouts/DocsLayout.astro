---
import "@/assets/app.css";
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/common/astro/layout/Navigation.astro";
import LeftMenu from "@/components/features/docs/astro/LeftMenu.astro";
import RightMenu from "@/components/features/docs/astro/RightMenu.astro";
import Breadcrumb from "@/components/features/docs/astro/Breadcrumb.astro";
import DocumentInfo from "@/components/features/docs/astro/DocumentInfo.astro";
import { getCollection, getEntry } from "astro:content";
import { compareSegments } from "@/utils/page_sorter";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  entry?: any;
  Content?: any;
  headings?: Array<{ slug: string; text: string; depth: number }> | undefined;
  tutorial?: any;
}

const {
  title: propTitle,
  description: propDescription,
  entry,
  Content,
  headings = [],
  tutorial,
} = Astro.props as Props;

const title = propTitle ?? entry?.data?.title ?? "FUSOU Docs";
const description = propDescription ?? entry?.data?.description;

const sectionHeadings = headings.filter(
  (heading: { depth: number }) => heading.depth >= 2,
);

let estimatedReadMinutes = 1;
let authors: any[] = [];
let prevDoc: any = null;
let nextDoc: any = null;

if (entry?.body) {
  const plainBody = entry.body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/<[^>]*>/g, " ")
    .replace(/\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/[^\p{L}\p{N}\s]/gu, " ");
  estimatedReadMinutes = Math.max(
    1,
    Math.ceil(plainBody.trim().split(/\s+/).filter(Boolean).length / 220),
  );
}

if (entry?.data?.contributors) {
  const rawAuthors = await Promise.all(
    entry.data.contributors.map(async (contributor: string) => {
      const a = await getEntry("authors", contributor);
      return a || { data: { github_username: contributor } };
    }),
  );
  authors = rawAuthors.filter(Boolean);
}

const currentSlug = (Astro.params["slug"] as string | undefined) ?? entry?.id ?? entry?.slug;

if (currentSlug) {
  const allDocs = await getCollection("docs");
  const sortedDocs = allDocs
    .map((d: any) => ({
      slug: (d.id || d.slug || "").replace(/\.md$/, ""),
      title: d.data?.title,
    }))
    .filter((d: any) => d.slug && d.title)
    .sort((a: any, b: any) => compareSegments({ segment: (a.slug || "").split("/").pop() ?? "" }, { segment: (b.slug || "").split("/").pop() ?? "" }));

  const normalizedCurrent = currentSlug.replace(/\.md$/, "");
  const currentIndex = sortedDocs.findIndex((d: any) => d.slug === normalizedCurrent);
  if (currentIndex > 0) {
    prevDoc = sortedDocs[currentIndex - 1];
  }
  if (currentIndex >= 0 && currentIndex < sortedDocs.length - 1) {
    nextDoc = sortedDocs[currentIndex + 1];
  }
}
---

<Layout title={title} description={description} tutorial={tutorial}>
  <slot name="head" slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=report,info,feedback,warning,lightbulb"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
    />
    <script type="module" is:inline>
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true });
    </script>
  </slot>

  <Navigation filled={true} />
  <div class="h-16"></div>
  <div class="fusou-page-shell flex w-full min-w-0">
    <div class="flex-1 min-w-0"></div>
    <div
      class="grid grid-cols-1 lg:grid-cols-24 gap-x-0 lg:gap-x-6 pt-4 max-w-[1600px] w-full min-w-0 px-4 sm:px-6 md:px-8"
    >
      <aside
        class="hidden lg:block lg:col-span-5 xl:col-span-4 xl:col-start-1 pr-3 sticky top-20 self-start h-fit min-w-0"
      >
        <LeftMenu />
      </aside>

      <main
        class="py-4 px-2 sm:px-4 md:px-4 xl:px-6 col-span-1 lg:col-span-13 xl:col-span-15 min-w-0"
      >
        {entry && <Breadcrumb entry={entry} />}
        {
          entry && (
            <header class="mb-6 pb-6 border-b border-base-300/60">
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-base-content tracking-tight">
                {entry.data.title}
              </h1>
              {
                entry.data.description && (
                  <p class="mt-3 text-base sm:text-lg text-base-content/75 leading-relaxed max-w-[70ch]">
                    {entry.data.description}
                  </p>
                )
              }
              <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-base-content/60">
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {estimatedReadMinutes} min read
                </span>
                <span>•</span>
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  Updated {
                    new Date(entry.data.date).toLocaleDateString(undefined, {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })
                  }
                </span>
                {sectionHeadings.length > 0 && (
                  <>
                    <span>•</span>
                    <span>{sectionHeadings.length} sections</span>
                  </>
                )}
              </div>
            </header>
          )
        }
        {
          sectionHeadings.length > 0 && (
            <div class="lg:hidden mb-6 rounded-xl border border-base-300/70 bg-base-100/80 p-4">
              <div class="flex items-center justify-between mb-3 border-b border-base-300/50 pb-2">
                <span class="text-sm font-bold text-base-content flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                  On this page (目次)
                </span>
                <span class="text-xs text-base-content/60">{sectionHeadings.length} sections</span>
              </div>
              <ul class="space-y-1.5 text-sm text-base-content/85">
                {sectionHeadings.map(
                  (heading: {
                    slug: string;
                    text: string;
                    depth: number;
                  }) => (
                    <li class={heading.depth >= 3 ? "pl-3 text-xs" : "pl-0 font-medium"}>
                      <a href={`#${heading.slug}`} class="link link-hover break-words leading-snug block text-brand hover:underline">
                        {heading.text}
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </div>
          )
        }
        {Content ? <div class="markdown"><Content /></div> : <slot />}
        {
          entry && (
            <>
              {/* Pagination */}
              {(prevDoc || nextDoc) && (
                <nav aria-label="Pagination" class="mt-12 pt-6 border-t border-base-300/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {prevDoc ? (
                    <a
                      href={`/docs/${prevDoc.slug}`}
                      class="group flex flex-col p-4 rounded-xl border border-base-300/70 bg-base-100/60 hover:bg-base-100 hover:border-primary/70 hover:shadow-sm transition-all text-left"
                    >
                      <span class="text-xs text-base-content/50 flex items-center gap-1 group-hover-text-brand transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        Previous
                      </span>
                      <span class="text-sm font-semibold text-base-content mt-1 group-hover-text-brand transition-colors truncate">
                        {prevDoc.title}
                      </span>
                    </a>
                  ) : <div />}

                  {nextDoc && (
                    <a
                      href={`/docs/${nextDoc.slug}`}
                      class="group flex flex-col p-4 rounded-xl border border-base-300/70 bg-base-100/60 hover:bg-base-100 hover:border-primary/50 transition-all text-right sm:col-start-2"
                    >
                      <span class="text-xs text-base-content/50 flex items-center justify-end gap-1 group-hover-text-brand transition-colors">
                        Next
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                      </span>
                      <span class="text-sm font-semibold text-base-content mt-1 group-hover-text-brand transition-colors truncate">
                        {nextDoc.title}
                      </span>
                    </a>
                  )}
                </nav>
              )}

              <div class="mt-8">
                <DocumentInfo lastUpdated={entry.data.date} contributors={authors} />
              </div>
            </>
          )
        }
      </main>

      <aside
        class="hidden lg:block lg:col-span-6 xl:col-span-5 pl-3 sticky top-20 self-start h-fit min-w-0"
      >
        <slot name="right-aside">
          {headings.length > 0 && <RightMenu headings={headings} />}
        </slot>
      </aside>
    </div>
    <div class="flex-1 min-w-0"></div>
  </div>
</Layout>

<style>
  :global(html),
  :global(body) {
    scrollbar-width: auto;
    scroll-padding-top: 100px !important;
  }
</style>
