# Copy this file to .env and encrypt it with the repository .env.keys file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TLSN_TEST_WORKER_NAME=fusou-tlsn-verification-test
TLSN_BINDING_TTL_SECONDS=60
TLSN_SERVER_IDENTITY=game.example.test
TLSN_PROFILE_SHA256=
# Optional. Required only for POST /verify/tlsn/sparse.
TLSN_SPARSE_PROFILE_SHA256=
TLSN_VERIFIER_KEY_ID=worker-test
TLSN_NOTARY_KEY_ID=notary-test
TLSN_NOTARY_REGISTRY=
TLSN_DEVICE_AUTH_URL=https://your-fusou-web.example/api/auth/anonymous-sync/v2/device-proof
TLSN_DEVICE_POSSESSION_AUTH_URL=https://your-fusou-web.example/api/auth/anonymous-sync/v2/tlsn-device-proof
TLSN_RESULT_SIGNING_PRIVATE_KEY_PKCS8=
TLSN_SESSION_AUTHORITY_SIGNING_PRIVATE_KEY_PKCS8=
TLSN_SESSION_AUTHORITY_PUBLIC_KEY_SPKI=
TLSN_SESSION_AUTHORITY_KEY_ID=session-authority-test
TLSN_SESSION_AUTHORITY_KEY_REGISTRY=
TLSN_BINDING_AUTHORITY_SIGNING_PRIVATE_KEY_PKCS8=
TLSN_BINDING_AUTHORITY_PUBLIC_KEY_SPKI=
TLSN_BINDING_AUTHORITY_KEY_ID=binding-authority-test
TLSN_BINDING_AUTHORITY_KEY_REGISTRY=
TLSN_TRUST_ROOT_CERTIFICATE_DER=
# Test-only synthetic fixture root key; keep encrypted and never deploy it as a Worker secret.
FUSOU_SYNTHETIC_ROOT_KEY_PKCS8=
TLSN_TEST_BINDING_VALUE=
TLSN_TEST_AUTH_USERS=
# Optional self-contained test auth. `pnpm run tlsn:benchmark:remote:setup`
# generates and encrypts these values into this package's .env.
TLSN_TEST_DEVICE_ID=
TLSN_TEST_DEVICE_PUBLIC_KEY=
TLSN_BENCHMARK_TIMINGS=true

# Required for the production-like benchmark. These values are consumed by
# the Worker deploy and are never forwarded to the Worker as bindings.
TLSN_EXECUTION_MODE=trigger
TLSN_TRIGGER_API_URL=https://api.trigger.dev
TLSN_TRIGGER_TASK_ID=
# Set once with dotenvx; subsequent deploy/benchmark commands load it automatically.
TLSN_TRIGGER_SECRET_KEY=
TLSN_TRIGGER_CALLBACK_SECRET=
TLSN_QUEUE_CALLBACK_SECRET=
TLSN_DIRECT_CALLBACK_SECRET=
TLSN_WORKER_INTERNAL_URL=https://your-test-worker.example

# Use these instead of TLSN_TEST_AUTH_USERS when testing Supabase auth.
TLSN_SUPABASE_URL=https://your-project.supabase.co
TLSN_SUPABASE_PUBLISHABLE_KEY=

# Remote benchmark client configuration. Keep access tokens and private keys
# in this encrypted dotenv file or export them only for the benchmark process.
TLSN_REMOTE_BENCHMARK_WORKER_URL=https://your-test-worker.example
TLSN_REMOTE_AUTH_MODE=test
# Only required for remote auth mode=supabase. Test mode is self-contained.
TLSN_REMOTE_WEB_ORIGIN=https://your-fusou-web.example
TLSN_REMOTE_SUPABASE_URL=https://your-project.supabase.co
TLSN_REMOTE_SUPABASE_PUBLISHABLE_KEY=
TLSN_REMOTE_ACCESS_TOKEN_A=
TLSN_REMOTE_DEVICE_ID_A=
TLSN_REMOTE_DEVICE_A_PRIVATE_KEY_PKCS8_B64URL=