{
  "name": "fusou-tlsn-verification-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker boundary for verified TLSNotary alpha.15 require_info results",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "pnpm run build:wasm && tsc --noEmit",
    "dev": "pnpm run build:wasm && wrangler dev",
    "deploy:test": "node scripts/deploy-test.mjs",
    "deploy:evidence": "node scripts/deploy-evidence.mjs",
    "deploy:replay": "node scripts/deploy-replay.mjs",
    "provision:replay": "node scripts/provision-tlsn-replay.mjs",
    "validate:replay": "node scripts/remote-replay-validation.mjs",
    "deploy": "pnpm run deploy:production",
    "deploy:canary": "node scripts/deploy-canary.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "preflight:production": "node scripts/deployment-preflight.mjs",
    "provision:canary": "node scripts/provision-canary-material.mjs",
    "render:app-config": "node scripts/render-app-config.mjs",
    "capture:deployment": "node scripts/capture-deployment.mjs",
    "capture:production-evidence": "pnpm run build:wasm && node scripts/capture-production-evidence.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:production-evidence": "pnpm run build:wasm && node scripts/verify-production-evidence.mjs",
    "verify:previous-deployment": "node scripts/verify-previous-deployment.mjs",
    "benchmark:sparse-parser": "node scripts/sparse-parser-memory-benchmark.mjs",
    "stats:require-info-fixtures": "node scripts/require-info-fixture-stats.mjs",
    "generate:sparse-fixtures": "node scripts/sparse-crypto-benchmark.mjs --generate",
      "benchmark:sparse-scope": "node scripts/sparse-crypto-benchmark.mjs --scope-regression",
      "generate:sparse-real-fixtures": "node scripts/sparse-crypto-benchmark.mjs --generate-real",
      "benchmark:sparse-real": "pnpm run build:wasm && node scripts/sparse-crypto-benchmark.mjs --real",
      "benchmark:sparse-real-regression": "pnpm run build:wasm && node scripts/sparse-crypto-benchmark.mjs --real-regression",
      "benchmark:tlsn-e2e": "pnpm run build:wasm && node scripts/benchmark-tlsn-e2e.mjs",
      "benchmark:tlsn-remote:preflight": "node scripts/benchmark-tlsn-remote-preflight.mjs",
      "benchmark:tlsn-remote:setup": "node scripts/setup-tlsn-remote-test.mjs",
      "benchmark:tlsn-remote:configure": "node scripts/configure-tlsn-remote-env.mjs",
      "benchmark:tlsn-remote:malicious-callback": "node scripts/remote-direct-malicious-callback.mjs",
      "benchmark:tlsn-remote:stale-attempt": "node scripts/remote-direct-stale-attempt.mjs",
      "benchmark:tlsn-payload-scaling": "node scripts/benchmark-tlsn-payload-scaling.mjs",
      "benchmark:tlsn-result-storage": "node scripts/benchmark-tlsn-result-storage.mjs",
      "test:stuck-job-age-alert": "node scripts/stuck-job-age-alert-dry-run.mjs",
      "benchmark:tlsn-remote": "pnpm run benchmark:tlsn-remote:preflight && pnpm run build:wasm && node scripts/benchmark-tlsn-remote.mjs",
      "test:tlsn-remote-analysis": "node scripts/benchmark-tlsn-remote-analysis-test.mjs",
    "validate:remote": "node scripts/remote-validation.mjs",
    "verify:remote-gate": "node scripts/verify-remote-gate.mjs",
    "types": "wrangler types",
    "test": "pnpm run build:wasm && pnpm run test:private-key-validation-cache && node scripts/production-trust-contract-test.mjs && pnpm run test:profile-contract && pnpm run test:security-registry-set-contract && node scripts/production-roundtrip-test.mjs && pnpm run test:isolation && pnpm run test:production-canary-provisioning && pnpm run test:replay-provisioning && node scripts/deployment-attestation-test.mjs && node scripts/signing-key-registry-test.mjs && node scripts/previous-deployment-contract-test.mjs && node scripts/production-evidence-test.mjs && node scripts/test.mjs",
    "test:app-roundtrip": "node scripts/test.mjs --app-roundtrip-only",
    "test:private-key-validation-cache": "TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm scripts/private-key-validation-cache-test.ts",
    "test:trust-contract": "node scripts/production-trust-contract-test.mjs",
    "test:profile-contract": "node scripts/profile-canonical-contract-test.mjs",
    "test:security-registry-set-contract": "node scripts/security-registry-set-contract-test.mjs",
    "test:production-roundtrip": "node scripts/production-roundtrip-test.mjs",
    "test:fixture-only": "node scripts/fixture-only-provisioning-test.mjs",
    "test:production-canary-provisioning": "node scripts/production-canary-provisioning-test.mjs",
    "test:replay-provisioning": "node scripts/replay-provisioning-test.mjs",
    "test:isolation": "node scripts/deployment-isolation-test.mjs && pnpm run test:fixture-only",
    "benchmark:sparse-crypto": "pnpm run build:wasm && node scripts/sparse-crypto-benchmark.mjs"
  },
  "keywords": [
    "cloudflare",
    "tlsnotary",
    "wasm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "hono": "^4.12.34",
    "zod": "^3.24.0"
  }
}